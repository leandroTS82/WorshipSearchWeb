@model WorshipSearchWeb.Models.MusicDocument
@{
    ViewData["Title"] = Model.Title;
    var fileName = ViewBag.FileName as string ?? "";
    var editUrl  = Url.Action("Edit", "MusicEditor", new { fileName })!;
    var backUrl  = ViewBag.BackUrl as string ?? Url.Action("Index", "Home")!;
    var themes   = Model.Search?.Themes        ?? new();
    var moods    = Model.Search?.Moods         ?? new();
    var moments  = Model.Search?.WorshipMoments?? new();
    var refs     = Model.Search?.BiblicalReferences ?? new();
    var topics   = Model.Search?.BiblicalTopics     ?? new();
    var contexts = Model.Search?.Contexts           ?? new();
    var keywords = Model.Search?.Keywords           ?? new();
    Func<string?, bool> hasText = s => !string.IsNullOrWhiteSpace(s);

    var cleanArtist  = System.Text.RegularExpressions.Regex.Replace(Model.Artist ?? "", @"\s*-\s*LETRAS\.MUS\.BR\s*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
    var searchQ      = Uri.EscapeDataString($"{Model.Title} {cleanArtist}");
    var ytSearchUrl  = $"https://www.youtube.com/results?search_query={searchQ}";
    var ccSearchUrl  = $"https://www.cifraclub.com.br/?q={searchQ}";
    var hasYoutube   = !string.IsNullOrWhiteSpace(Model.Metadata?.YoutubeId);
    var hasCifra     = !string.IsNullOrWhiteSpace(Model.Metadata?.CifraClubUrl);
}

<style>
.sv-toggle-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    padding: 14px 20px;
    border-bottom: 1px solid transparent;
    transition: border-color .15s;
}
.sv-toggle-header:hover { background: rgba(255,255,255,.03); }
.sv-toggle-header.open { border-bottom-color: var(--border-card); }
.sv-toggle-icon {
    flex-shrink: 0;
    transition: transform .2s;
    color: var(--text-dim);
}
.sv-toggle-header.open .sv-toggle-icon { transform: rotate(180deg); }
.sv-toggle-body { display: none; padding: 20px; }
.sv-toggle-body.open { display: block; }
.sv-lyrics {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--text-sub);
    white-space: pre-wrap;
    font-family: 'Spectral', serif;
}
.sv-section-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .6px;
    color: var(--text-dim);
    margin-bottom: 10px;
}
.sv-meta-row {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-muted);
}
.sv-edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 20px;
    border-radius: 10px;
    background: var(--accent-soft);
    border: 1.5px solid var(--accent-line);
    color: var(--accent);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background .13s, border-color .13s;
}
.sv-edit-btn:hover {
    background: rgba(214,145,95,.18);
    border-color: var(--accent);
}
</style>

<div style="max-width:860px;margin:0 auto" class="ws-fade">

    <!-- Top bar -->
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;flex-wrap:wrap">
        <a href="@backUrl" class="ws-btn ws-btn-ghost ws-btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 5 5 12 12 19"/></svg>
            Voltar
        </a>
        <div style="flex:1"></div>
        <button type="button" id="copyBtn" onclick="copyLyricsWithTitle()" class="ws-btn ws-btn-ghost ws-btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copiar letra
        </button>
        <button type="button" id="copyNameBtn" onclick="copyName()" class="ws-btn ws-btn-ghost ws-btn-sm" title="Copiar nome e artista">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></svg>
            Copiar nome
        </button>
        @if (hasYoutube)
        {
            <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" onclick="openYtModal()" title="Assistir no YouTube" style="color:#e53">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                YouTube
            </button>
        }
        else
        {
            <a href="@ytSearchUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Buscar no YouTube" style="color:#e53;opacity:.7">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
                YouTube
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Metadata?.CanonicalUrl))
        {
            <a href="@Model.Metadata.CanonicalUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Ver letra (letras.mus.br)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h12"/></svg>
                Letra
            </a>
        }
        @if (hasCifra)
        {
            <a href="@Model.Metadata!.CifraClubUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Ver cifras (CifraClub)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                Cifra
            </a>
        }
        else
        {
            <a href="@ccSearchUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Buscar no CifraClub" style="opacity:.7">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
                Cifra
            </a>
        }
        <button type="button" id="shareBtn" onclick="shareMusic()" class="ws-btn ws-btn-ghost ws-btn-sm" title="Compartilhar">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Compartilhar
        </button>
        <a href="@editUrl" class="sv-edit-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Habilitar Edição
        </a>
    </div>

    <!-- Header card -->
    <div class="ws-card" style="padding:24px;margin-bottom:16px">
        <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Metadata?.Image))
            {
                <img src="@Model.Metadata.Image" width="80" height="80"
                     style="border-radius:14px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
            }
            else
            {
                <div style="width:80px;height:80px;border-radius:14px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.3" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                </div>
            }
            <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap;margin-bottom:6px">
                    <h1 style="font-family:'Spectral',serif;font-size:26px;font-weight:500;margin:0;line-height:1.2">@Model.Title</h1>
                </div>
                <div class="sv-meta-row">
                    <span>@Model.Artist</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Album)) { <span>@Model.Album</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Genre))  { <span>@Model.Genre</span> }
                    @if (!string.IsNullOrWhiteSpace(Model.Language)) { <span style="text-transform:uppercase;font-size:11px">@Model.Language</span> }
                </div>
                @if (moments.Count > 0)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
                        @foreach (var m in moments)
                        {
                            <span style="font-size:12px;padding:3px 10px;border-radius:999px;background:rgba(214,145,95,.12);border:1px solid rgba(214,145,95,.25);color:var(--accent)">@m</span>
                        }
                    </div>
                }
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p style="margin:18px 0 0;font-size:14.5px;line-height:1.65;color:var(--text-sub);padding-top:16px;border-top:1px solid var(--border-card)">@Model.Summary</p>
        }
    </div>

    <!-- Tags -->
    @{
        var hasTags = themes.Count > 0 || moods.Count > 0 || refs.Count > 0 || topics.Count > 0 || contexts.Count > 0 || keywords.Count > 0;
    }
    @if (hasTags)
    {
        <div class="ws-card" style="margin-bottom:16px;overflow:hidden">
            <div class="sv-toggle-header" onclick="svToggle(this)">
                <span class="sv-section-label" style="margin:0">Tags</span>
                <svg class="sv-toggle-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="sv-toggle-body">
                <div style="display:flex;flex-direction:column;gap:12px">
                    @if (themes.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Temas</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var t in themes) { <span class="ws-chip ws-chip-theme">@t</span> }
                            </div>
                        </div>
                    }
                    @if (moods.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Emoções</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var m in moods) { <span class="ws-chip ws-chip-mood">@m</span> }
                            </div>
                        </div>
                    }
                    @if (refs.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Bíblia</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var r in refs) { <span class="ws-chip ws-chip-ref">@r</span> }
                            </div>
                        </div>
                    }
                    @if (topics.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Tópicos</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var t in topics) { <span style="font-size:12px;padding:3px 9px;border-radius:999px;background:var(--bg-input);border:1px solid var(--border-card);color:var(--text-sub)">@t</span> }
                            </div>
                        </div>
                    }
                    @if (contexts.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Contextos</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var c in contexts) { <span style="font-size:12px;padding:3px 9px;border-radius:999px;background:var(--bg-input);border:1px solid var(--border-card);color:var(--text-sub)">@c</span> }
                            </div>
                        </div>
                    }
                    @if (keywords.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">
                            <span style="font-size:12px;color:var(--text-dim);width:70px;flex-shrink:0">Keywords</span>
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var k in keywords.Take(12)) { <span style="font-size:12px;padding:3px 9px;border-radius:999px;background:var(--bg-input);border:1px solid var(--border-card);color:var(--text-sub)">@k</span> }
                                @if (keywords.Count > 12) { <span style="font-size:12px;color:var(--text-dim);padding:3px 4px">+@(keywords.Count - 12)</span> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Explanation / Practical -->
    @if (!string.IsNullOrWhiteSpace(Model.Explanation) || !string.IsNullOrWhiteSpace(Model.PracticalApplication))
    {
        <div class="ws-card" style="margin-bottom:16px;overflow:hidden">
            <div class="sv-toggle-header" onclick="svToggle(this)">
                <span class="sv-section-label" style="margin:0">Análise</span>
                <svg class="sv-toggle-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="sv-toggle-body">
                <div style="display:flex;flex-direction:column;gap:16px">
                    @if (!string.IsNullOrWhiteSpace(Model.Explanation))
                    {
                        <div>
                            <div class="sv-section-label">Explicação teológica</div>
                            <p style="margin:0;font-size:14px;line-height:1.65;color:var(--text-sub)">@Model.Explanation</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.PracticalApplication))
                    {
                        <div>
                            <div class="sv-section-label">Aplicação prática</div>
                            <p style="margin:0;font-size:14px;line-height:1.65;color:var(--text-sub)">@Model.PracticalApplication</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Lyrics -->
    @if (!string.IsNullOrWhiteSpace(Model.Lyrics))
    {
        <div class="ws-card" style="padding:0;margin-bottom:16px;overflow:hidden">
            <div style="padding:14px 20px;border-bottom:1px solid var(--border-card);display:flex;align-items:center;justify-content:space-between">
                <span class="sv-section-label" style="margin:0">Letra</span>
                <button type="button" id="copyBtnLyrics" onclick="copyLyricsWithTitle()" class="ws-btn ws-btn-ghost ws-btn-sm" style="padding:4px 12px;font-size:12px">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copiar com título
                </button>
            </div>
            <div style="padding:22px 24px">
                <div class="sv-lyrics" id="lyricsContent">@Model.Lyrics</div>
            </div>
        </div>
    }

    <!-- Bottom edit CTA -->
    <div style="display:flex;justify-content:flex-end;padding:8px 0 32px">
        <a href="@editUrl" class="sv-edit-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Habilitar Edição
        </a>
    </div>

</div>

@if (!string.IsNullOrWhiteSpace(Model.Metadata?.YoutubeId))
{
<!-- YouTube embed modal -->
<div id="yt-modal" onclick="closeYtModal()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:9000;align-items:center;justify-content:center">
    <div onclick="event.stopPropagation()" style="position:relative;width:min(680px,94vw);aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.7)">
        <iframe id="yt-iframe" width="100%" height="100%" frameborder="0" allowfullscreen
            allow="autoplay; encrypted-media"
            style="position:absolute;inset:0;width:100%;height:100%"></iframe>
        <button onclick="closeYtModal()" style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,.6);border:none;color:#fff;border-radius:50%;width:32px;height:32px;font-size:18px;cursor:pointer;line-height:32px;text-align:center">×</button>
    </div>
</div>
}

@section Scripts {
<script>
function svToggle(header) {
    header.classList.toggle('open');
    var body = header.nextElementSibling;
    body.classList.toggle('open');
}

var songTitle    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Title ?? ""));
var songArtist   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Artist ?? ""));
var songLetras   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Metadata?.CanonicalUrl ?? ""));
var songCifra    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Metadata?.CifraClubUrl ?? ""));
var songYoutubeId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Metadata?.YoutubeId ?? ""));

function copyLyricsWithTitle() {
    var lyrics = document.getElementById('lyricsContent');
    if (!lyrics) return;
    var text = songTitle + '\n' + songArtist + '\n\n' + lyrics.innerText;
    navigator.clipboard.writeText(text).then(function() {
        flashCopy();
    }).catch(function() {
        var range = document.createRange();
        range.selectNode(lyrics);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        window.getSelection().removeAllRanges();
        flashCopy();
    });
}

function copyName() {
    var cleanArtist = songArtist.replace(/\s*-\s*LETRAS\.MUS\.BR\s*$/i, '').trim();
    var text = songTitle + ' - ' + cleanArtist;
    navigator.clipboard.writeText(text).then(function() { flashCopyName(); }).catch(function() { flashCopyName(); });
}

function flashCopyName() {
    var btn = document.getElementById('copyNameBtn');
    if (!btn) return;
    var orig = btn.innerHTML;
    btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Copiado!';
    setTimeout(function(){ btn.innerHTML = orig; }, 1600);
}

function flashCopy() {
    ['copyBtn','copyBtnLyrics'].forEach(function(id) {
        var btn = document.getElementById(id);
        if (!btn) return;
        var orig = btn.innerHTML;
        btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Copiado!';
        setTimeout(function(){ btn.innerHTML = orig; }, 1600);
    });
}

// YouTube embed modal
function openYtModal() {
    if (!songYoutubeId) return;
    document.getElementById('yt-iframe').src = 'https://www.youtube.com/embed/' + songYoutubeId + '?autoplay=1';
    var m = document.getElementById('yt-modal');
    m.style.display = 'flex';
    document.body.style.overflow = 'hidden';
}
function closeYtModal() {
    var m = document.getElementById('yt-modal');
    if (m) { m.style.display = 'none'; document.getElementById('yt-iframe').src = ''; }
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeYtModal(); });

// Share
function shareMusic() {
    var parts = [songTitle + ' — ' + songArtist];
    if (songLetras)  parts.push('Letra: ' + songLetras);
    if (songCifra)   parts.push('Cifra: ' + songCifra);
    if (songYoutubeId) parts.push('YouTube: https://www.youtube.com/watch?v=' + songYoutubeId);
    var text = parts.join('\n');
    if (navigator.share) {
        navigator.share({ title: songTitle, text: text }).catch(function(){});
    } else {
        navigator.clipboard.writeText(text).then(function() {
            var btn = document.getElementById('shareBtn');
            var orig = btn.innerHTML;
            btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Copiado!';
            setTimeout(function(){ btn.innerHTML = orig; }, 1600);
        });
    }
}
</script>
}
