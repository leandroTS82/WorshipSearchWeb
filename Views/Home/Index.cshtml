@model List<WorshipSearchWeb.Models.LibrarySearchResult>
@{
    ViewData["Title"] = "Pesquisar";
    var query = ViewBag.Query as string ?? "";
    var approvedOnly = (bool)(ViewBag.ApprovedOnly ?? false);
    var criteriaCount = (int)(ViewBag.CriteriaCount ?? 0);
    var classifiedCriteria = ViewBag.ClassifiedCriteria as List<WorshipSearchWeb.Models.SearchCriterion>;

    var allSuggestions = new[] {
        "gratidão", "cura", "esperança", "adoração", "Salmo 91", "Santa Ceia",
        "abertura", "Romanos 8", "intercessão", "louvor", "fé", "graça",
        "perdão", "salvação", "avivamento", "presença", "encerramento",
        "Natal", "Páscoa", "batismo", "consagração", "ofertório"
    };
    var activeTerms = (query ?? "")
        .Split(';', StringSplitOptions.RemoveEmptyEntries)
        .Select(t => t.Trim())
        .Where(t => t.Length > 0)
        .ToArray();

    // Split results when multiple criteria were searched
    var fullMatch = criteriaCount > 1
        ? Model.Where(r => r.MatchedTerms >= criteriaCount).ToList()
        : Model;
    var partialMatch = criteriaCount > 1
        ? Model.Where(r => r.MatchedTerms > 0 && r.MatchedTerms < criteriaCount).ToList()
        : new List<WorshipSearchWeb.Models.LibrarySearchResult>();
}

<style>
.ws-tag-box {
    background: var(--bg-input);
    border: 1px solid #38301f;
    border-radius: 14px;
    padding: 10px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    min-height: 54px;
    cursor: text;
    transition: border-color .15s;
}
.ws-tag-box:focus-within { border-color: var(--accent-line); }

.ws-active-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px 5px 12px;
    background: var(--accent);
    border-radius: 999px;
    color: #1a1008;
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: default;
}
.ws-active-tag button {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(26,16,8,.6);
    font-size: 16px;
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    transition: color .1s;
}
.ws-active-tag button:hover { color: #1a1008; }

.ws-tag-input {
    border: none;
    background: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 15px;
    flex: 1;
    min-width: 120px;
    padding: 4px 2px;
}
.ws-tag-input::placeholder { color: var(--text-dim); }

/* Picker dropdown */
.ws-tag-picker {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 14px;
    padding: 14px;
    z-index: 300;
    box-shadow: 0 12px 32px rgba(0,0,0,.45);
    display: none;
}
.ws-tag-picker.open { display: block; }
.ws-tag-picker-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .6px;
    color: var(--text-dim);
    margin-bottom: 10px;
}
.ws-picker-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}
.ws-picker-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bg-input);
    border: 1px solid var(--border-card);
    color: var(--text-sub);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: all .12s;
}
.ws-picker-chip:hover {
    border-color: var(--accent-line);
    color: var(--accent);
    background: var(--accent-soft);
}
.ws-picker-chip svg { flex-shrink: 0; }

.ws-help-tip {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(214,145,95,0.05);
    border: 1px solid rgba(214,145,95,0.18);
    border-radius: 10px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
}
.ws-help-tip strong { color: var(--text-sub); }
.ws-help-tip kbd {
    font-family: inherit;
    font-size: 11.5px;
    padding: 1px 6px;
    border: 1px solid var(--border-card);
    border-radius: 5px;
    background: var(--bg-input);
    color: var(--accent);
    font-weight: 600;
}

@@media (max-width: 860px) {
    .ws-tag-input { min-width: 80px; font-size: 14px; }
}
</style>

<div style="max-width:900px;margin:0 auto" class="ws-fade">

    <div style="margin-bottom:16px">
        <div class="ws-page-title">Encontre o louvor certo</div>
    </div>

    <!-- How it works tip -->
    <div class="ws-help-tip" data-tip-id="search-criteria" data-tip-feature="pesquisa-criterios">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
            Digite um tema ou versículo e pressione <kbd>Enter</kbd> ou <kbd>;</kbd> para adicionar como critério.
            Você pode combinar vários — ex: <strong>Deus vai libertar</strong> + <strong>Salmos 21</strong> — e o sistema trará primeiro os louvores que atendem a todos os critérios, depois os parciais.
        </span>
        <button type="button" class="ws-tip-close" data-tip-close="search-criteria" title="Não mostrar novamente">×</button>
    </div>

    <form method="get" action="@Url.Action("Index","Home")" id="search-form">
        <input type="hidden" name="q" id="q-hidden" value="@query" />
        <input type="hidden" name="approvedOnly" id="ao-hidden" value="@(approvedOnly ? "true" : "")" />

        <!-- Tag box -->
        <div style="position:relative;margin-bottom:10px">
            <div class="ws-tag-box" id="tag-box" onclick="focusTagInput()">
                <!-- Active tags rendered here by JS -->
                <div id="active-tags-area" style="display:contents"></div>
                <input type="text" id="tag-text-input" class="ws-tag-input"
                       placeholder="@(activeTerms.Length == 0 ? "Tema, versículo ou emoção… pressione ; para adicionar" : "Adicionar critério…")"
                       autocomplete="off" />
            </div>

            <!-- Suggestions picker dropdown -->
            <div class="ws-tag-picker" id="tag-picker">
                <div class="ws-tag-picker-label">Sugestões rápidas</div>
                <div class="ws-picker-chips" id="picker-chips"></div>
            </div>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <button type="button" id="add-tag-btn" onclick="togglePicker()"
                        class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Sugestões
                </button>
                <label style="display:flex;align-items:center;gap:7px;cursor:pointer;font-size:13px;color:var(--text-muted)">
                    <input type="checkbox" id="ao-check" @(approvedOnly ? "checked" : "")
                           style="width:14px;height:14px;accent-color:var(--accent)" />
                    Apenas aprovadas
                </label>
                @if (activeTerms.Length > 0)
                {
                    <button type="button" onclick="clearAllTags()"
                            style="background:none;border:none;color:var(--text-dim);font-family:inherit;font-size:13px;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:2px">
                        Limpar tudo
                    </button>
                }
            </div>
            <button type="submit" id="search-btn" class="ws-btn ws-btn-primary" style="padding:10px 22px">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
                Buscar
            </button>
        </div>
    </form>

    @if ((bool)(ViewBag.LlmExpanded ?? false))
    {
        var llmDesc = ViewBag.LlmExpandedDescription as string;
        <div style="display:flex;align-items:center;gap:8px;margin-top:16px;padding:10px 14px;background:rgba(214,145,95,0.08);border:1px solid var(--accent-line);border-radius:10px;font-size:13px;color:var(--accent)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @if (!string.IsNullOrWhiteSpace(llmDesc))
            {
                <span>Nenhum resultado direto — IA ampliou a busca para <strong>@llmDesc</strong>.</span>
            }
            else
            {
                <span>Nenhum resultado direto — busca ampliada por IA com termos relacionados.</span>
            }
        </div>
    }

    @if (classifiedCriteria != null && classifiedCriteria.Count > 0)
    {
        <div style="margin-top:16px;padding:14px 18px;background:rgba(214,145,95,0.05);border:1px solid var(--accent-line);border-radius:12px">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:10px">Interpretação da busca</div>
            <div style="display:flex;flex-direction:column;gap:9px">
                @foreach (var c in classifiedCriteria)
                {
                    var previewTags = new List<string>();
                    previewTags.AddRange(c.Tags.Themes.Take(2));
                    previewTags.AddRange(c.Tags.Moods.Take(2));
                    previewTags.AddRange(c.Tags.BiblicalTopics.Take(2));
                    previewTags.AddRange(c.Tags.WorshipMoments.Take(2));
                    previewTags.AddRange(c.Tags.Contexts.Take(1));
                    previewTags.AddRange(c.Tags.Keywords.Take(1));

                    var typeLabel = c.Type switch {
                        "biblical_reference" => "ref. bíblica",
                        "worship_moment"     => "momento",
                        "mood"               => "emoção",
                        "context"            => "contexto",
                        "theme"              => "tema",
                        _                    => "geral"
                    };

                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <span style="font-weight:500;color:var(--text);font-size:13.5px;min-width:100px;flex-shrink:0">@c.Input</span>
                        <span style="font-size:11px;color:var(--text-dim);border:1px solid var(--border);border-radius:999px;padding:2px 8px;flex-shrink:0">@typeLabel</span>
                        @foreach (var tag in previewTags.Distinct().Take(5))
                        {
                            <span style="font-size:11.5px;padding:2px 8px;background:var(--bg-input);border:1px solid var(--border-card);border-radius:999px;color:var(--text-muted)">@tag</span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Count > 0)
    {
        if (criteriaCount > 1)
        {
            <!-- Full-match section -->
            <div class="ws-section-header" style="margin-top:24px">
                <span class="ws-section-title">
                    Correspondência total
                    <span style="font-size:13px;font-weight:400;color:var(--text-muted);margin-left:6px">(@fullMatch.Count)</span>
                </span>
                <a href="@Url.Action("Index","MusicSearch")" class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Adicionar música
                </a>
            </div>
            @if (fullMatch.Count > 0)
            {
                <div class="ws-grid ws-grid-3">
                    @foreach (var item in fullMatch)
                    {
                        var doc = item.Document;
                        var editUrl = Url.Action("Edit","MusicEditor", new { fileName = item.FileName })!;
                        <div class="ws-card ws-fade">
                            <a href="@editUrl" style="display:block;padding:18px 18px 14px;text-decoration:none;color:inherit">
                                <div style="display:flex;align-items:flex-start;gap:13px;margin-bottom:12px">
                                    @if (!string.IsNullOrWhiteSpace(doc.Metadata?.Image))
                                    {
                                        <img src="@doc.Metadata.Image" width="46" height="46"
                                             style="border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
                                    }
                                    else
                                    {
                                        <div style="width:46px;height:46px;border-radius:9px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Title</div>
                                        <div style="color:var(--text-muted);font-size:13px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Artist</div>
                                    </div>
                                    @if (doc.Approved)
                                    {
                                        <span class="ws-badge-ok">✓</span>
                                    }
                                    else
                                    {
                                        <span class="ws-badge-pend">revisão</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(doc.Summary))
                                {
                                    <p class="ws-summary-text" style="font-size:13px;color:var(--text-sub);line-height:1.55;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer"
                                       onclick="event.preventDefault();toggleSummary(this)">@doc.Summary</p>
                                }
                                <div style="display:flex;flex-wrap:wrap;gap:5px">
                                    @foreach (var t in (doc.Search?.Themes ?? new()).Take(3))
                                    {
                                        <span class="ws-chip ws-chip-theme">@t</span>
                                    }
                                    @foreach (var m in (doc.Search?.Moods ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-mood">@m</span>
                                    }
                                    @foreach (var r in (doc.Search?.BiblicalReferences ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-ref">@r</span>
                                    }
                                </div>
                                @if (item.MatchedCriteria.Count > 0)
                                {
                                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:7px">
                                        @foreach (var mc in item.MatchedCriteria)
                                        {
                                            <span style="font-size:11px;padding:2px 8px;background:rgba(214,145,95,0.12);border:1px solid rgba(214,145,95,0.3);border-radius:999px;color:var(--accent)">✓ @mc</span>
                                        }
                                    </div>
                                }
                            </a>
                            <div style="padding:12px 18px;border-top:1px solid var(--border-card);display:flex;gap:8px">
                                <a href="@editUrl" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex:1">Editar</a>
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.YoutubeUrl))
                                {
                                    <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" data-yt-url="@doc.Metadata.YoutubeUrl" title="Ver no YouTube">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.CanonicalUrl))
                                {
                                    <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" data-share-url="@doc.Metadata.CanonicalUrl" title="Copiar link da música">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13.5px">
                    Nenhuma música cobre todos os critérios ao mesmo tempo.
                </div>
            }

            @if (partialMatch.Count > 0)
            {
                <!-- Partial-match section -->
                <div class="ws-section-header" style="margin-top:28px">
                    <span class="ws-section-title" style="color:var(--text-muted)">
                        Correspondência parcial
                        <span style="font-size:13px;font-weight:400;margin-left:6px">(@partialMatch.Count)</span>
                    </span>
                </div>
                <div style="font-size:13px;color:var(--text-dim);margin-bottom:12px">
                    Estes louvores atendem a pelo menos um dos critérios buscados.
                </div>
                <div class="ws-grid ws-grid-3">
                    @foreach (var item in partialMatch)
                    {
                        var doc = item.Document;
                        var editUrl = Url.Action("Edit","MusicEditor", new { fileName = item.FileName })!;
                        <div class="ws-card ws-fade" style="opacity:.85">
                            <a href="@editUrl" style="display:block;padding:18px 18px 14px;text-decoration:none;color:inherit">
                                <div style="display:flex;align-items:flex-start;gap:13px;margin-bottom:12px">
                                    @if (!string.IsNullOrWhiteSpace(doc.Metadata?.Image))
                                    {
                                        <img src="@doc.Metadata.Image" width="46" height="46"
                                             style="border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
                                    }
                                    else
                                    {
                                        <div style="width:46px;height:46px;border-radius:9px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Title</div>
                                        <div style="color:var(--text-muted);font-size:13px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Artist</div>
                                    </div>
                                    @if (doc.Approved)
                                    {
                                        <span class="ws-badge-ok">✓</span>
                                    }
                                    else
                                    {
                                        <span class="ws-badge-pend">revisão</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(doc.Summary))
                                {
                                    <p class="ws-summary-text" style="font-size:13px;color:var(--text-sub);line-height:1.55;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer"
                                       onclick="event.preventDefault();toggleSummary(this)">@doc.Summary</p>
                                }
                                <div style="display:flex;flex-wrap:wrap;gap:5px">
                                    @foreach (var t in (doc.Search?.Themes ?? new()).Take(3))
                                    {
                                        <span class="ws-chip ws-chip-theme">@t</span>
                                    }
                                    @foreach (var m in (doc.Search?.Moods ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-mood">@m</span>
                                    }
                                    @foreach (var r in (doc.Search?.BiblicalReferences ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-ref">@r</span>
                                    }
                                </div>
                                @if (item.MatchedCriteria.Count > 0)
                                {
                                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:7px">
                                        @foreach (var mc in item.MatchedCriteria)
                                        {
                                            <span style="font-size:11px;padding:2px 8px;background:rgba(214,145,95,0.12);border:1px solid rgba(214,145,95,0.3);border-radius:999px;color:var(--accent)">✓ @mc</span>
                                        }
                                    </div>
                                }
                            </a>
                            <div style="padding:12px 18px;border-top:1px solid var(--border-card);display:flex;gap:8px">
                                <a href="@editUrl" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex:1">Editar</a>
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.YoutubeUrl))
                                {
                                    <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" data-yt-url="@doc.Metadata.YoutubeUrl" title="Ver no YouTube">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    </button>
                                }
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.CanonicalUrl))
                                {
                                    <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" data-share-url="@doc.Metadata.CanonicalUrl" title="Copiar link da música">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="ws-section-header" style="margin-top:24px">
                <span class="ws-section-title">
                    @if (!string.IsNullOrWhiteSpace(query))
                    {
                        @($"{Model.Count} resultado(s) para \"{query}\"")
                    }
                    else
                    {
                        <span>Biblioteca</span>
                    }
                </span>
                <a href="@Url.Action("Index","MusicSearch")" class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Adicionar música
                </a>
            </div>
            <div class="ws-grid ws-grid-3">
                @foreach (var item in Model)
                {
                    var doc = item.Document;
                    var editUrl = Url.Action("Edit","MusicEditor", new { fileName = item.FileName })!;
                    <div class="ws-card ws-fade">
                        <a href="@editUrl" style="display:block;padding:18px 18px 14px;text-decoration:none;color:inherit">
                            <div style="display:flex;align-items:flex-start;gap:13px;margin-bottom:12px">
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.Image))
                                {
                                    <img src="@doc.Metadata.Image" width="46" height="46"
                                         style="border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
                                }
                                else
                                {
                                    <div style="width:46px;height:46px;border-radius:9px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                    </div>
                                }
                                <div style="flex:1;min-width:0">
                                    <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Title</div>
                                    <div style="color:var(--text-muted);font-size:13px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Artist</div>
                                </div>
                                @if (doc.Approved)
                                {
                                    <span class="ws-badge-ok">✓</span>
                                }
                                else
                                {
                                    <span class="ws-badge-pend">revisão</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(doc.Summary))
                            {
                                <p class="ws-summary-text" style="font-size:13px;color:var(--text-sub);line-height:1.55;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer"
                                   onclick="event.preventDefault();toggleSummary(this)">@doc.Summary</p>
                            }
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var t in (doc.Search?.Themes ?? new()).Take(3))
                                {
                                    <span class="ws-chip ws-chip-theme">@t</span>
                                }
                                @foreach (var m in (doc.Search?.Moods ?? new()).Take(2))
                                {
                                    <span class="ws-chip ws-chip-mood">@m</span>
                                }
                                @foreach (var r in (doc.Search?.BiblicalReferences ?? new()).Take(2))
                                {
                                    <span class="ws-chip ws-chip-ref">@r</span>
                                }
                            </div>
                        </a>
                        <div style="padding:12px 18px;border-top:1px solid var(--border-card);display:flex;gap:8px">
                            <a href="@editUrl" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex:1">Editar</a>
                            @if (!string.IsNullOrWhiteSpace(doc.Metadata?.CanonicalUrl))
                            {
                                <a href="@doc.Metadata.CanonicalUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (!string.IsNullOrWhiteSpace(query))
    {
        <div class="ws-section-header" style="margin-top:24px">
            <span class="ws-section-title">Nenhum resultado</span>
            <a href="@Url.Action("Index","MusicSearch")" class="ws-btn ws-btn-ghost ws-btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Indexar música
            </a>
        </div>
        <div style="text-align:center;padding:64px 0;color:var(--text-muted)">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin-bottom:16px;opacity:.5"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
            <div style="font-size:15px;margin-bottom:8px">Nenhuma música para "@query"</div>
            <div style="font-size:13.5px">Tente <a href="@Url.Action("Index","MusicSearch")" style="color:var(--accent)">adicionar uma música</a> com esse tema.</div>
        </div>
    }
    else
    {
        <div class="ws-section-header" style="margin-top:24px">
            <span class="ws-section-title">Biblioteca</span>
            <a href="@Url.Action("Index","MusicSearch")" class="ws-btn ws-btn-ghost ws-btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Indexar música
            </a>
        </div>
        <div style="text-align:center;padding:64px 0;color:var(--text-muted)">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin-bottom:16px;opacity:.5"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
            <div style="font-size:15px;margin-bottom:8px">Biblioteca vazia</div>
            <div style="font-size:13.5px"><a href="@Url.Action("Index","MusicSearch")" style="color:var(--accent)">Adicione músicas</a> para começar.</div>
        </div>
    }

</div>

@section Scripts {
<script>
(function () {
    // --- State ---
    var activeTags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        activeTerms.Length > 0 ? activeTerms : Array.Empty<string>()
    ));

    var allSuggestions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allSuggestions));

    var pickerOpen = false;

    // --- DOM refs ---
    var tagsArea   = document.getElementById('active-tags-area');
    var textInput  = document.getElementById('tag-text-input');
    var hiddenQ    = document.getElementById('q-hidden');
    var hiddenAO   = document.getElementById('ao-hidden');
    var aoCheck    = document.getElementById('ao-check');
    var picker     = document.getElementById('tag-picker');
    var pickerChips = document.getElementById('picker-chips');
    var addBtn     = document.getElementById('add-tag-btn');

    // --- Render active tags ---
    function renderActiveTags() {
        tagsArea.innerHTML = '';
        activeTags.forEach(function (tag) {
            var chip = document.createElement('span');
            chip.className = 'ws-active-tag';
            chip.innerHTML =
                '<span>' + escHtml(tag) + '</span>' +
                '<button type="button" aria-label="Remover ' + escHtml(tag) + '" onclick="removeTag(\'' + escHtml(tag).replace(/'/g, "\\'") + '\')">×</button>';
            tagsArea.appendChild(chip);
        });
        syncHidden();
        renderPickerChips();
        textInput.placeholder = activeTags.length === 0
            ? 'Tema, versículo ou emoção… pressione ; para adicionar'
            : 'Adicionar critério…';
    }

    function syncHidden() {
        hiddenQ.value = activeTags.join(';');
        hiddenAO.value = aoCheck.checked ? 'true' : '';
    }

    // --- Picker chips ---
    function renderPickerChips() {
        pickerChips.innerHTML = '';
        var remaining = allSuggestions.filter(function (s) {
            return !activeTags.some(function (a) { return a.toLowerCase() === s.toLowerCase(); });
        });
        if (remaining.length === 0) {
            pickerChips.innerHTML = '<span style="color:var(--text-dim);font-size:13px">Todas as sugestões já estão ativas.</span>';
            return;
        }
        remaining.forEach(function (s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ws-picker-chip';
            btn.innerHTML =
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' +
                escHtml(s);
            btn.addEventListener('click', function () { addTag(s); });
            pickerChips.appendChild(btn);
        });
    }

    // --- Add / Remove ---
    window.addTag = function (tag) {
        tag = tag.trim();
        if (!tag) return;
        if (activeTags.some(function (a) { return a.toLowerCase() === tag.toLowerCase(); })) return;
        activeTags.push(tag);
        renderActiveTags();
        textInput.value = '';
        textInput.focus();
    };

    window.removeTag = function (tag) {
        activeTags = activeTags.filter(function (a) { return a.toLowerCase() !== tag.toLowerCase(); });
        renderActiveTags();
        document.getElementById('search-form').submit();
    };

    window.clearAllTags = function () {
        activeTags = [];
        renderActiveTags();
        document.getElementById('search-form').submit();
    };

    // --- Picker toggle ---
    window.togglePicker = function () {
        pickerOpen = !pickerOpen;
        picker.classList.toggle('open', pickerOpen);
        if (pickerOpen) { renderPickerChips(); textInput.focus(); }
    };

    // Close picker on outside click
    document.addEventListener('click', function (e) {
        if (pickerOpen && !picker.contains(e.target) && e.target !== addBtn && !addBtn.contains(e.target)) {
            pickerOpen = false;
            picker.classList.remove('open');
        }
    });

    // Focus text input when clicking the box
    window.focusTagInput = function () { textInput.focus(); };

    // --- Text input: Enter / semicolon / comma adds tag ---
    textInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            var val = textInput.value.trim();
            if (val) {
                // Support "tema A; tema B" pasted or typed before Enter
                val.split(';').map(function(s){ return s.trim(); }).filter(Boolean).forEach(addTag);
                textInput.value = '';
            } else {
                document.getElementById('search-form').submit();
            }
        } else if (e.key === ';' || e.key === ',') {
            e.preventDefault();
            var val = textInput.value.replace(/[;,]/g, '').trim();
            if (val) addTag(val);
        } else if (e.key === 'Backspace' && textInput.value === '' && activeTags.length > 0) {
            activeTags.pop();
            renderActiveTags();
        }
    });

    // Sync approvedOnly checkbox
    aoCheck.addEventListener('change', function () {
        syncHidden();
        document.getElementById('search-form').submit();
    });

    // Flush any typed text into tags before submitting
    document.getElementById('search-form').addEventListener('submit', function () {
        var val = textInput.value.trim();
        if (val) {
            val.split(';').map(function(s){ return s.trim(); }).filter(Boolean).forEach(function(t) {
                if (!activeTags.some(function(a){ return a.toLowerCase() === t.toLowerCase(); }))
                    activeTags.push(t);
            });
        }
        syncHidden();
    });

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // --- Init ---
    renderActiveTags();

})();

function toggleSummary(el) {
    if (el.getAttribute('data-expanded') === '1') {
        el.removeAttribute('data-expanded');
        el.style.webkitLineClamp = '2';
        el.style.overflow = 'hidden';
        el.style.display = '-webkit-box';
    } else {
        el.setAttribute('data-expanded', '1');
        el.style.webkitLineClamp = 'unset';
        el.style.overflow = 'visible';
        el.style.display = 'block';
    }
}
</script>
}
