(function () {
    // --- State ---
    var activeTags = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        activeTerms.Length > 0 ? activeTerms : Array.Empty<string>()
    ));

    var allSuggestions        = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allSuggestions));
    var additionalSuggestions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(additionalSuggestions));

    var pickerOpen = false;

    // --- DOM refs ---
    var tagsArea    = document.getElementById('active-tags-area');
    var textInput   = document.getElementById('tag-text-input');
    var hiddenQ     = document.getElementById('q-hidden');
    var picker      = document.getElementById('tag-picker');
    var pickerChips = document.getElementById('picker-chips');
    var addBtn      = document.getElementById('add-tag-btn');
    var inlineChips = document.getElementById('inline-sugg-chips');

    // --- Render active tags ---
    function renderActiveTags() {
        tagsArea.innerHTML = '';
        activeTags.forEach(function (tag) {
            var chip = document.createElement('span');
            chip.className = 'ws-active-tag';
            chip.innerHTML =
                '<span>' + escHtml(tag) + '</span>' +
                '<button type="button" aria-label="Remover ' + escHtml(tag) + '" onclick="removeTag(\'' + escHtml(tag).replace(/'/g, "\\'") + '\')">×</button>';
            tagsArea.appendChild(chip);
        });
        syncHidden();
        renderPickerChips();
        renderInlineChips();
        textInput.placeholder = activeTags.length === 0
            ? 'Tema, versículo ou emoção… pressione ; para adicionar'
            : 'Adicionar critério…';
    }

    function syncHidden() {
        hiddenQ.value = activeTags.join(';');
    }

    // --- Inline additional suggestion chips (always visible) ---
    function renderInlineChips() {
        inlineChips.innerHTML = '';
        var activeSet = activeTags.map(function(a){ return a.toLowerCase(); });
        var remaining = additionalSuggestions.filter(function(s){
            return !activeSet.includes(s.toLowerCase());
        });
        remaining.forEach(function(s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:999px;background:rgba(214,145,95,0.1);border:1px solid rgba(214,145,95,0.28);color:var(--accent);font-family:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;flex-shrink:0';
            btn.textContent = s;
            btn.addEventListener('click', function(){ addTag(s); });
            inlineChips.appendChild(btn);
        });
        // Always show additional chips; always show the "+ Sugestões" button alongside
        inlineChips.style.display = remaining.length > 0 ? 'flex' : 'none';
        addBtn.style.display = allSuggestions.length > 0 ? '' : 'none';
    }

    // --- Picker chips (only auto-suggestions, not additional) ---
    function renderPickerChips() {
        pickerChips.innerHTML = '';
        var activeSet = activeTags.map(function(a){ return a.toLowerCase(); });
        var remaining = allSuggestions.filter(function(s){
            return !activeSet.includes(s.toLowerCase());
        });
        if (remaining.length === 0) {
            pickerChips.innerHTML = '<span style="color:var(--text-dim);font-size:13px">Todas as sugestões já estão ativas.</span>';
            return;
        }
        remaining.forEach(function (s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ws-picker-chip';
            btn.innerHTML =
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' +
                escHtml(s);
            btn.addEventListener('click', function () { addTag(s); });
            pickerChips.appendChild(btn);
        });
    }

    // --- Add / Remove ---
    window.addTag = function (tag) {
        tag = tag.trim();
        if (!tag) return;
        if (activeTags.some(function (a) { return a.toLowerCase() === tag.toLowerCase(); })) return;
        activeTags.push(tag);
        renderActiveTags();
        textInput.value = '';
        textInput.focus();
    };

    window.removeTag = function (tag) {
        activeTags = activeTags.filter(function (a) { return a.toLowerCase() !== tag.toLowerCase(); });
        renderActiveTags();
        document.getElementById('search-form').submit();
    };

    window.clearAllTags = function () {
        activeTags = [];
        renderActiveTags();
        document.getElementById('search-form').submit();
    };

    // --- Picker toggle ---
    window.togglePicker = function () {
        pickerOpen = !pickerOpen;
        picker.classList.toggle('open', pickerOpen);
        if (pickerOpen) { renderPickerChips(); textInput.focus(); }
    };

    // Close picker on outside click
    document.addEventListener('click', function (e) {
        if (pickerOpen && !picker.contains(e.target) && e.target !== addBtn && !addBtn.contains(e.target)) {
            pickerOpen = false;
            picker.classList.remove('open');
        }
    });

    // Focus text input when clicking the box
    window.focusTagInput = function () { textInput.focus(); };

    // --- Text input: Enter / semicolon / comma adds tag ---
    textInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            var val = textInput.value.trim();
            if (val) {
                // Support "tema A; tema B" pasted or typed before Enter
                val.split(';').map(function(s){ return s.trim(); }).filter(Boolean).forEach(addTag);
                textInput.value = '';
            } else {
                document.getElementById('search-form').submit();
            }
        } else if (e.key === ';' || e.key === ',') {
            e.preventDefault();
            var val = textInput.value.replace(/[;,]/g, '').trim();
            if (val) addTag(val);
        } else if (e.key === 'Backspace' && textInput.value === '' && activeTags.length > 0) {
            activeTags.pop();
            renderActiveTags();
        }
    });

    // Flush any typed text into tags before submitting
    document.getElementById('search-form').addEventListener('submit', function () {
        var val = textInput.value.trim();
        if (val) {
            val.split(';').map(function(s){ return s.trim(); }).filter(Boolean).forEach(function(t) {
                if (!activeTags.some(function(a){ return a.toLowerCase() === t.toLowerCase(); }))
                    activeTags.push(t);
            });
        }
        syncHidden();
    });

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // --- Init ---
    renderActiveTags();

})();

function toggleSummary(el) {
    if (el.getAttribute('data-expanded') === '1') {
        el.removeAttribute('data-expanded');
        el.style.webkitLineClamp = '2';
        el.style.overflow = 'hidden';
        el.style.display = '-webkit-box';
    } else {
        el.setAttribute('data-expanded', '1');
        el.style.webkitLineClamp = 'unset';
        el.style.overflow = 'visible';
        el.style.display = 'block';
    }
}

// ── YouTube modal ─────────────────────────────────────────────────────
function openYtModal(ytId, title, artist, letras, cifra) {
    var m = document.getElementById('yt-global-modal');
    if (!m) return;
    document.getElementById('yt-global-iframe').src = 'https://www.youtube.com/embed/' + ytId + '?autoplay=1';
    m.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    // store for share
    m.dataset.title  = title;
    m.dataset.artist = artist;
    m.dataset.letras = letras;
    m.dataset.cifra  = cifra;
    m.dataset.ytid   = ytId;
}
function closeYtModal() {
    var m = document.getElementById('yt-global-modal');
    if (m) { m.style.display = 'none'; document.getElementById('yt-global-iframe').src = ''; }
    document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeYtModal(); });

// ── Copy card name ────────────────────────────────────────────────────
function copyCardName(title, artist) {
    var clean = artist.replace(/\s*-\s*LETRAS\.MUS\.BR\s*$/i, '').trim();
    navigator.clipboard.writeText(title + ' - ' + clean).catch(function(){});
}

// ── Share card ────────────────────────────────────────────────────────
function shareCard(title, artist, letras, cifra, ytId) {
    var parts = [title + ' — ' + artist];
    if (letras) parts.push('Letra: ' + letras);
    if (cifra)  parts.push('Cifra: ' + cifra);
    if (ytId)   parts.push('YouTube: https://www.youtube.com/watch?v=' + ytId);
    var text = parts.join('\n');
    if (navigator.share) {
        navigator.share({ title: title, text: text }).catch(function(){});
    } else {
        navigator.clipboard.writeText(text).catch(function(){});
    }
}
</script>

<!-- YouTube embed modal (global) -->
<div id="yt-global-modal" onclick="closeYtModal()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:9000;align-items:center;justify-content:center">
    <div onclick="event.stopPropagation()" style="position:relative;width:min(680px,94vw);aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.7)">
        <iframe id="yt-global-iframe" width="100%" height="100%" frameborder="0" allowfullscreen
            allow="autoplay; encrypted-media"
            style="position:absolute;inset:0;width:100%;height:100%"></iframe>
        <button onclick="closeYtModal()" style="position:absolute;top:10px;right:10px;background:rgba(0,0,0,.6);border:none;color:#fff;border-radius:50%;width:32px;height:32px;font-size:18px;cursor:pointer;line-height:32px;text-align:center">×</button>
    </div>
</div>
}
