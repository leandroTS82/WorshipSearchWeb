@model List<WorshipSearchWeb.Models.LibrarySearchResult>
@{
    ViewData["Title"] = "Pesquisar";
    var query = ViewBag.Query as string ?? "";
    var criteriaCount = (int)(ViewBag.CriteriaCount ?? 0);
    var classifiedCriteria = ViewBag.ClassifiedCriteria as List<WorshipSearchWeb.Models.SearchCriterion>;

    var allSuggestions = ViewBag.Suggestions as string[] ?? Array.Empty<string>();
    var additionalSuggestions = ViewBag.AdditionalSuggestions as string[] ?? Array.Empty<string>();
    var activeTerms = (query ?? "")
        .Split(';', StringSplitOptions.RemoveEmptyEntries)
        .Select(t => t.Trim())
        .Where(t => t.Length > 0)
        .ToArray();

    // Split results when multiple criteria were searched
    var fullMatch = criteriaCount > 1
        ? Model.Where(r => r.MatchedTerms >= criteriaCount).ToList()
        : Model;
    var partialMatch = criteriaCount > 1
        ? Model.Where(r => r.MatchedTerms > 0 && r.MatchedTerms < criteriaCount).ToList()
        : new List<WorshipSearchWeb.Models.LibrarySearchResult>();

    Func<string, string, string> CardSearchQ = (title, artist) =>
        Uri.EscapeDataString(title + " " + System.Text.RegularExpressions.Regex
            .Replace(artist ?? "", @"\s*-\s*LETRAS\.MUS\.BR\s*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
            .Trim());
}

<style>
.ws-tag-box {
    background: rgba(214,145,95,0.07);
    border: 1px solid rgba(214,145,95,0.32);
    border-radius: 14px;
    padding: 10px 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    min-height: 54px;
    cursor: text;
    transition: border-color .15s, box-shadow .15s;
}
.ws-tag-box:focus-within {
    border-color: rgba(214,145,95,0.75);
    box-shadow: 0 0 0 3px rgba(214,145,95,0.1);
}

.ws-active-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px 5px 12px;
    background: var(--accent);
    border-radius: 999px;
    color: #1a1008;
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    cursor: default;
}
.ws-active-tag button {
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(26,16,8,.6);
    font-size: 16px;
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    transition: color .1s;
}
.ws-active-tag button:hover { color: #1a1008; }

.ws-tag-input {
    border: none;
    background: none;
    outline: none;
    color: #d6a870;
    font-family: inherit;
    font-size: 15px;
    flex: 1;
    min-width: 120px;
    padding: 4px 2px;
}
.ws-tag-input::placeholder { color: var(--text-dim); }

/* Picker dropdown */
.ws-tag-picker {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 14px;
    padding: 14px;
    z-index: 300;
    box-shadow: 0 12px 32px rgba(0,0,0,.45);
    display: none;
}
.ws-tag-picker.open { display: block; }
.ws-tag-picker-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .6px;
    color: var(--text-dim);
    margin-bottom: 10px;
}
.ws-picker-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    max-height: 220px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-card) transparent;
}
.ws-picker-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--bg-input);
    border: 1px solid var(--border-card);
    color: var(--text-sub);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: all .12s;
}
.ws-picker-chip:hover {
    border-color: var(--accent-line);
    color: var(--accent);
    background: var(--accent-soft);
}
.ws-picker-chip svg { flex-shrink: 0; }

.ws-help-tip {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(214,145,95,0.05);
    border: 1px solid rgba(214,145,95,0.18);
    border-radius: 10px;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 12px;
}
.ws-help-tip strong { color: var(--text-sub); }
.ws-help-tip kbd {
    font-family: inherit;
    font-size: 11.5px;
    padding: 1px 6px;
    border: 1px solid var(--border-card);
    border-radius: 5px;
    background: var(--bg-input);
    color: var(--accent);
    font-weight: 600;
}

@@media (max-width: 860px) {
    .ws-tag-input { min-width: 80px; font-size: 14px; }
}
</style>

<div style="max-width:900px;margin:0 auto" class="ws-fade">

    <div style="margin-bottom:16px">
        <div class="ws-page-title">Encontre o louvor certo</div>
    </div>

    <!-- How it works tip -->
    <div class="ws-help-tip" data-tip-id="search-criteria" data-tip-feature="pesquisa-criterios">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
            Digite um tema ou versículo e pressione <kbd>Enter</kbd> ou <kbd>;</kbd> para adicionar como critério.
            Você pode combinar vários — ex: <strong>Deus vai libertar</strong> + <strong>Salmos 21</strong> — e o sistema trará primeiro os louvores que atendem a todos os critérios, depois os parciais.
        </span>
        <button type="button" class="ws-tip-close" data-tip-close="search-criteria" title="Não mostrar novamente">×</button>
    </div>

    <form method="get" action="@Url.Action("Index","Home")" id="search-form">
        <input type="hidden" name="q" id="q-hidden" value="@query" />

        <!-- Tag box -->
        <div style="position:relative;margin-bottom:10px">
            <div class="ws-tag-box" id="tag-box" onclick="focusTagInput()">
                <!-- Active tags rendered here by JS -->
                <div id="active-tags-area" style="display:contents"></div>
                <input type="text" id="tag-text-input" class="ws-tag-input"
                       placeholder="@(activeTerms.Length == 0 ? "Tema, versículo ou emoção… pressione ; para adicionar" : "Adicionar critério…")"
                       autocomplete="off" />
            </div>

            <!-- Suggestions picker dropdown -->
            <div class="ws-tag-picker" id="tag-picker">
                <div class="ws-tag-picker-label">Sugestões rápidas</div>
                <div class="ws-picker-chips" id="picker-chips"></div>
            </div>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px">
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap" id="controls-row">
                <button type="button" id="add-tag-btn" onclick="togglePicker()"
                        class="ws-btn ws-btn-ghost ws-btn-sm" style="display:none">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Sugestões
                </button>
                <div id="inline-sugg-chips" style="display:flex;align-items:center;gap:6px;flex-wrap:nowrap;overflow:hidden;max-width:500px"></div>
                @if (activeTerms.Length > 0)
                {
                    <button type="button" onclick="clearAllTags()"
                            style="background:none;border:none;color:var(--text-dim);font-family:inherit;font-size:13px;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:2px;white-space:nowrap">
                        Limpar tudo
                    </button>
                }
            </div>
            <button type="submit" id="search-btn" class="ws-btn ws-btn-primary" style="padding:10px 22px">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
                Buscar
            </button>
        </div>
    </form>

    @if ((bool)(ViewBag.LlmExpanded ?? false))
    {
        var llmDesc = ViewBag.LlmExpandedDescription as string;
        <div style="display:flex;align-items:center;gap:8px;margin-top:16px;padding:10px 14px;background:rgba(214,145,95,0.08);border:1px solid var(--accent-line);border-radius:10px;font-size:13px;color:var(--accent)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            @if (!string.IsNullOrWhiteSpace(llmDesc))
            {
                <span>Nenhum resultado direto — busca ampliada para <strong>@llmDesc</strong>.</span>
            }
            else
            {
                <span>Nenhum resultado direto — busca ampliada com termos relacionados.</span>
            }
        </div>
    }

    @if (classifiedCriteria != null && classifiedCriteria.Count > 0)
    {
        <div style="margin-top:16px;padding:14px 18px;background:rgba(214,145,95,0.05);border:1px solid var(--accent-line);border-radius:12px">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--text-dim);margin-bottom:10px">Interpretação da busca</div>
            <div style="display:flex;flex-direction:column;gap:9px">
                @foreach (var c in classifiedCriteria)
                {
                    var previewTags = new List<string>();
                    previewTags.AddRange(c.Tags.Themes.Take(2));
                    previewTags.AddRange(c.Tags.Moods.Take(2));
                    previewTags.AddRange(c.Tags.BiblicalTopics.Take(2));
                    previewTags.AddRange(c.Tags.WorshipMoments.Take(2));
                    previewTags.AddRange(c.Tags.Contexts.Take(1));
                    previewTags.AddRange(c.Tags.Keywords.Take(1));

                    var typeLabel = c.Type switch {
                        "biblical_reference" => "ref. bíblica",
                        "worship_moment"     => "momento",
                        "mood"               => "emoção",
                        "context"            => "contexto",
                        "theme"              => "tema",
                        _                    => "geral"
                    };

                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <span style="font-weight:500;color:var(--text);font-size:13.5px;min-width:100px;flex-shrink:0">@c.Input</span>
                        <span style="font-size:11px;color:var(--text-dim);border:1px solid var(--border);border-radius:999px;padding:2px 8px;flex-shrink:0">@typeLabel</span>
                        @foreach (var tag in previewTags.Distinct().Take(5))
                        {
                            <span style="font-size:11.5px;padding:2px 8px;background:var(--bg-input);border:1px solid var(--border-card);border-radius:999px;color:var(--text-muted)">@tag</span>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Count > 0)
    {
        if (criteriaCount > 1)
        {
            <!-- Full-match section -->
            <div class="ws-section-header" style="margin-top:24px">
                <span class="ws-section-title">
                    Correspondência total
                    <span style="font-size:13px;font-weight:400;color:var(--text-muted);margin-left:6px">(@fullMatch.Count)</span>
                </span>
                <a href="@Url.Action("Index","MusicSearch")" class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Adicionar música
                </a>
            </div>
            @if (fullMatch.Count > 0)
            {
                <div class="ws-grid ws-grid-3">
                    @foreach (var item in fullMatch)
                    {
                        var doc = item.Document;
                        var editUrl = Url.Action("Edit","MusicEditor", new { fileName = item.FileName })!;
                        var viewUrl = Url.Action("SongView","MusicEditor", new { fileName = item.FileName })!;
                        <div class="ws-card ws-fade">
                            <a href="@viewUrl" style="display:block;padding:18px 18px 14px;text-decoration:none;color:inherit">
                                <div style="display:flex;align-items:flex-start;gap:13px;margin-bottom:12px">
                                    @if (!string.IsNullOrWhiteSpace(doc.Metadata?.Image))
                                    {
                                        <img src="@doc.Metadata.Image" width="46" height="46"
                                             style="border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
                                    }
                                    else
                                    {
                                        <div style="width:46px;height:46px;border-radius:9px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Title</div>
                                        <div style="color:var(--text-muted);font-size:13px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Artist</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(doc.Summary))
                                {
                                    <p class="ws-summary-text" style="font-size:13px;color:var(--text-sub);line-height:1.55;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer"
                                       onclick="event.preventDefault();toggleSummary(this)">@doc.Summary</p>
                                }
                                <div style="display:flex;flex-wrap:wrap;gap:5px">
                                    @foreach (var t in (doc.Search?.Themes ?? new()).Take(3))
                                    {
                                        <span class="ws-chip ws-chip-theme">@t</span>
                                    }
                                    @foreach (var m in (doc.Search?.Moods ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-mood">@m</span>
                                    }
                                    @foreach (var r in (doc.Search?.BiblicalReferences ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-ref">@r</span>
                                    }
                                </div>
                                @if (item.MatchedCriteria.Count > 0)
                                {
                                    <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:7px">
                                        @foreach (var mc in item.MatchedCriteria)
                                        {
                                            <span style="font-size:11px;padding:2px 8px;background:rgba(214,145,95,0.12);border:1px solid rgba(214,145,95,0.3);border-radius:999px;color:var(--accent)">✓ @mc</span>
                                        }
                                    </div>
                                }
                            </a>
                            <div style="padding:12px 18px;border-top:1px solid var(--border-card);display:flex;gap:8px">
                                <a href="@editUrl" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex:1">Editar</a>
                                @{ var _q = CardSearchQ(doc.Title, doc.Artist); }
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.YoutubeId))
                                {
                                    <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" style="color:#e53"
                                        onclick="openYtModal('@doc.Metadata.YoutubeId',@(System.Text.Json.JsonSerializer.Serialize(doc.Title)),@(System.Text.Json.JsonSerializer.Serialize(doc.Artist)),@(System.Text.Json.JsonSerializer.Serialize(doc.Metadata?.CanonicalUrl??"")),@(System.Text.Json.JsonSerializer.Serialize(doc.Metadata?.CifraClubUrl??"")))"
                                        title="Ver no YouTube">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    </button>
                                }
                                else
                                {
                                    <a href="https://www.youtube.com/results?search_query=@_q" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Buscar no YouTube" style="color:#e53;opacity:.65">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
                                    </a>
                                }
                                <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm" onclick="copyCardName(@(System.Text.Json.JsonSerializer.Serialize(doc.Title)),@(System.Text.Json.JsonSerializer.Serialize(doc.Artist)))" title="Copiar nome e artista">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></svg>
                                </button>
                                <button type="button" class="ws-btn ws-btn-ghost ws-btn-sm"
                                    onclick="shareCard(@(System.Text.Json.JsonSerializer.Serialize(doc.Title)),@(System.Text.Json.JsonSerializer.Serialize(doc.Artist)),@(System.Text.Json.JsonSerializer.Serialize(doc.Metadata?.CanonicalUrl??"")),@(System.Text.Json.JsonSerializer.Serialize(doc.Metadata?.CifraClubUrl??"")),@(System.Text.Json.JsonSerializer.Serialize(doc.Metadata?.YoutubeId??"")))"
                                    title="Compartilhar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                                </button>
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.CanonicalUrl))
                                {
                                    <a href="@doc.Metadata.CanonicalUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Ver letra">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h12"/></svg>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(doc.Metadata?.CifraClubUrl))
                                {
                                    <a href="@doc.Metadata.CifraClubUrl" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Ver cifra (CifraClub)">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                    </a>
                                }
                                else
                                {
                                    <a href="https://www.cifraclub.com.br/?q=@_q" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" title="Buscar no CifraClub" style="opacity:.65">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="padding:20px;text-align:center;color:var(--text-muted);font-size:13.5px">
                    Nenhuma música cobre todos os critérios ao mesmo tempo.
                </div>
            }

            @if (partialMatch.Count > 0)
            {
                <!-- Partial-match section -->
                <div class="ws-section-header" style="margin-top:28px">
                    <span class="ws-section-title" style="color:var(--text-muted)">
                        Correspondência parcial
                        <span style="font-size:13px;font-weight:400;margin-left:6px">(@partialMatch.Count)</span>
                    </span>
                </div>
                <div style="font-size:13px;color:var(--text-dim);margin-bottom:12px">
                    Estes louvores atendem a pelo menos um dos critérios buscados.
                </div>
                <div class="ws-grid ws-grid-3">
                    @foreach (var item in partialMatch)
                    {
                        var doc = item.Document;
                        var editUrl = Url.Action("Edit","MusicEditor", new { fileName = item.FileName })!;
                        var viewUrl = Url.Action("SongView","MusicEditor", new { fileName = item.FileName })!;
                        <div class="ws-card ws-fade" style="opacity:.85">
                            <a href="@viewUrl" style="display:block;padding:18px 18px 14px;text-decoration:none;color:inherit">
                                <div style="display:flex;align-items:flex-start;gap:13px;margin-bottom:12px">
                                    @if (!string.IsNullOrWhiteSpace(doc.Metadata?.Image))
                                    {
                                        <img src="@doc.Metadata.Image" width="46" height="46"
                                             style="border-radius:9px;object-fit:cover;flex-shrink:0;border:1px solid var(--border)" alt="" />
                                    }
                                    else
                                    {
                                        <div style="width:46px;height:46px;border-radius:9px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                        </div>
                                    }
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Title</div>
                                        <div style="color:var(--text-muted);font-size:13px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@doc.Artist</div>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(doc.Summary))
                                {
                                    <p class="ws-summary-text" style="font-size:13px;color:var(--text-sub);line-height:1.55;margin-bottom:12px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer"
                                       onclick="event.preventDefault();toggleSummary(this)">@doc.Summary</p>
                                }
                                <div style="display:flex;flex-wrap:wrap;gap:5px">
                                    @foreach (var t in (doc.Search?.Themes ?? new()).Take(3))
                                    {
                                        <span class="ws-chip ws-chip-theme">@t</span>
                                    }
                                    @foreach (var m in (doc.Search?.Moods ?? new()).Take(2))
                                    {
                                        <span class="ws-chip ws-chip-mood">@m</span>
                                    }
