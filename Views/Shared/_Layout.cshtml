<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – WorshipSearchWeb</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Spectral:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#d6915f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="WorshipSearch" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <style>
        :root {
            --bg: #181511;
            --bg-side: #1c1813;
            --bg-card: #201b14;
            --bg-input: #221c15;
            --border: #2e2820;
            --border-card: #2a2418;
            --accent: #d6915f;
            --accent-soft: rgba(214,145,95,0.14);
            --accent-line: rgba(214,145,95,0.32);
            --text: #ece3d4;
            --text-muted: #8a7e6e;
            --text-sub: #b9ad9b;
            --text-dim: #766a5b;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Instrument Sans', system-ui, sans-serif;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
            display: flex;
            min-height: 100vh;
        }
        input::placeholder { color: var(--text-dim); }
        ::selection { background: var(--accent-soft); }

        /* Scrollbar */
        #ws-scroll::-webkit-scrollbar { width: 8px; }
        #ws-scroll::-webkit-scrollbar-thumb { background: #332c24; border-radius: 8px; border: 3px solid var(--bg); }
        #ws-scroll::-webkit-scrollbar-track { background: transparent; }

        /* Sidebar */
        #ws-side {
            width: 258px;
            flex: 0 0 258px;
            height: 100vh;
            position: sticky;
            top: 0;
            display: flex;
            flex-direction: column;
            padding: 26px 18px;
            border-right: 1px solid var(--border);
            background: var(--bg-side);
        }
        #ws-brand {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 0 6px;
            margin-bottom: 30px;
        }
        .ws-logo {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: var(--accent-soft);
            border: 1px solid var(--accent-line);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .ws-brand-text { font-family: 'Spectral', serif; font-size: 18px; letter-spacing: .2px; }
        .ws-brand-text span { color: var(--accent); }

        #ws-nav { display: flex; flex-direction: column; gap: 3px; }
        .ws-nav-btn {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 12px;
            border: none; border-radius: 9px;
            background: transparent;
            color: var(--text-muted);
            font-family: inherit; font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            transition: background .12s, color .12s;
            width: 100%;
            text-align: left;
        }
        .ws-nav-btn:hover { background: #241f18; color: var(--text); }
        .ws-nav-btn.active { background: #241f18; color: var(--text); }
        .ws-nav-btn svg { flex-shrink: 0; }

        #ws-stats {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 14px;
            padding-top: 22px;
            border-top: 1px solid var(--border-card);
        }
        .ws-stat-row { display: flex; align-items: baseline; justify-content: space-between; }
        .ws-stat-label { color: var(--text-muted); font-size: 12.5px; }
        .ws-stat-val { font-family: 'Spectral', serif; font-size: 18px; }
        .ws-stat-bar { height: 5px; border-radius: 3px; background: var(--border-card); overflow: hidden; margin-top: 7px; }
        .ws-stat-fill { height: 100%; background: var(--accent); border-radius: 3px; }

        /* Main */
        #ws-main { flex: 1; min-width: 0; height: 100vh; overflow: hidden; }
        #ws-scroll { height: 100%; overflow-y: auto; padding: 40px 44px 80px; }

        /* Alerts */
        .ws-alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .ws-alert-error { background: #2a1215; border: 1px solid #5c2b2e; color: #ff8a80; }
        .ws-alert-success { background: #122016; border: 1px solid #1d4a2b; color: #69d18a; }
        .ws-alert-close { background: none; border: none; color: inherit; cursor: pointer; font-size: 18px; line-height: 1; opacity: .7; }
        .ws-alert-close:hover { opacity: 1; }

        /* Cards */
        .ws-card {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 14px;
            overflow: hidden;
            transition: border-color .15s;
        }
        .ws-card:hover { border-color: #3a3020; }

        /* Input */
        .ws-input {
            width: 100%;
            padding: 14px 18px;
            background: var(--bg-input);
            border: 1px solid rgba(214,145,95,0.32);
            border-radius: 12px;
            color: #d6a870;
            font-family: inherit;
            font-size: 15px;
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }
        .ws-input::placeholder { color: rgba(214,145,95,0.38); }
        .ws-input:focus {
            border-color: rgba(214,145,95,0.75);
            box-shadow: 0 0 0 3px rgba(214,145,95,0.1);
        }
        .ws-input-icon { padding-left: 48px; }

        /* Buttons */
        .ws-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 7px;
            padding: 10px 18px;
            border: none; border-radius: 10px;
            font-family: inherit; font-size: 14px; font-weight: 500;
            cursor: pointer;
            transition: opacity .12s, background .12s;
            text-decoration: none;
            white-space: nowrap;
        }
        .ws-btn:disabled { opacity: .45; cursor: not-allowed; }
        .ws-btn-primary { background: var(--accent); color: #1a1008; }
        .ws-btn-primary:hover { opacity: .88; }
        .ws-btn-ghost { background: rgba(255,255,255,0.06); color: var(--text-sub); border: 1px solid var(--border); }
        .ws-btn-ghost:hover { background: rgba(255,255,255,0.1); color: var(--text); }
        .ws-btn-danger { background: rgba(220,50,50,0.15); color: #ff8a80; border: 1px solid rgba(220,50,50,0.2); }
        .ws-btn-danger:hover { background: rgba(220,50,50,0.25); }
        .ws-btn-sm { padding: 6px 12px; font-size: 13px; }

        /* Chips */
        .ws-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 12px;
        }
        .ws-chip-theme { background: rgba(214,145,95,0.14); border: 1px solid rgba(214,145,95,0.28); color: #d6a870; }
        .ws-chip-mood  { background: rgba(100,180,120,0.12); border: 1px solid rgba(100,180,120,0.25); color: #7ec99a; }
        .ws-chip-ref   { background: rgba(140,100,200,0.12); border: 1px solid rgba(140,100,200,0.25); color: #b89ee0; }
        .ws-chip-kw    { background: rgba(80,160,220,0.12);  border: 1px solid rgba(80,160,220,0.25);  color: #80c4e8; }

        /* Badge approved */
        .ws-badge-ok  { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 6px; font-size: 11.5px; background: rgba(60,180,90,0.15); border: 1px solid rgba(60,180,90,0.25); color: #69d18a; }
        .ws-badge-pend{ display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 6px; font-size: 11.5px; background: rgba(200,160,60,0.12); border: 1px solid rgba(200,160,60,0.22); color: #c9a857; }

        /* Section header */
        .ws-section-header {
            display: flex; align-items: center; justify-content: space-between;
            margin: 28px 0 14px;
            padding-bottom: 13px;
            border-bottom: 1px solid var(--border-card);
        }
        .ws-section-title { color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .7px; }

        /* Page title */
        .ws-page-title { font-family: 'Spectral', serif; font-size: 28px; font-weight: 400; letter-spacing: .2px; margin-bottom: 6px; }
        .ws-page-sub { color: var(--text-muted); font-size: 14.5px; line-height: 1.55; }

        /* Grid */
        .ws-grid { display: grid; gap: 14px; }
        .ws-grid-3 { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
        .ws-grid-2 { grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); }

        /* Forms */
        .ws-label { display: block; color: var(--text-muted); font-size: 12.5px; margin-bottom: 6px; letter-spacing: .3px; }
        .ws-form-group { margin-bottom: 18px; }
        textarea.ws-input { min-height: 90px; resize: vertical; }

        /* Table */
        .ws-table { width: 100%; border-collapse: collapse; }
        .ws-table th { font-size: 12px; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); padding: 10px 14px; border-bottom: 1px solid var(--border-card); text-align: left; font-weight: 500; }
        .ws-table td { padding: 12px 14px; border-bottom: 1px solid var(--border-card); font-size: 14px; vertical-align: middle; }
        .ws-table tr:last-child td { border-bottom: none; }
        .ws-table tr:hover td { background: rgba(255,255,255,0.02); }

        /* Divider */
        .ws-divider { height: 1px; background: var(--border-card); margin: 24px 0; }

        /* Fade animation */
        @@keyframes wsfade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
        .ws-fade { animation: wsfade .2s ease; }

        /* Spinner */
        .ws-spinner { display: inline-block; width: 18px; height: 18px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .6s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* Dismissable tips */
        .ws-tip-close {
            background: none; border: none; cursor: pointer;
            color: var(--text-dim); font-size: 20px; line-height: 1;
            padding: 0; margin-left: auto; flex-shrink: 0;
            display: flex; align-items: center;
            transition: color .12s;
        }
        .ws-tip-close:hover { color: var(--text-muted); }

        /* Hamburger button */
        #ws-hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            color: var(--text-muted);
            flex-shrink: 0;
        }
        #ws-hamburger:hover { background: #241f18; color: var(--text); }

        /* Mobile nav overlay */
        #ws-nav-mobile {
            display: none;
            position: fixed;
            top: 57px;
            left: 0;
            right: 0;
            background: var(--bg-side);
            border-bottom: 1px solid var(--border);
            z-index: 200;
            padding: 8px 14px 14px;
            flex-direction: column;
            gap: 3px;
            box-shadow: 0 8px 24px rgba(0,0,0,.35);
        }
        #ws-nav-mobile.open { display: flex; }

        /* Responsive */
        @@media (max-width: 860px) {
            body { flex-direction: column; }
            #ws-side {
                width: 100%; height: auto; flex: none; position: sticky; top: 0; z-index: 100;
                flex-direction: row; align-items: center; justify-content: space-between;
                padding: 10px 14px; border-right: none; border-bottom: 1px solid var(--border);
            }
            #ws-hamburger { display: flex; align-items: center; justify-content: center; }
            #ws-nav { display: none; }
            #ws-stats { display: none; }
            #ws-brand { margin-bottom: 0; }
            #ws-main { height: auto; }
            #ws-scroll { height: auto; padding: 20px 14px 60px; }
            .ws-grid-3 { grid-template-columns: 1fr; }
            .ws-grid-2 { grid-template-columns: 1fr; }
            .ws-page-title { font-size: 22px; }
        }
    </style>
</head>
<body>

<aside id="ws-side">
    <div id="ws-brand">
        <div class="ws-logo">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l11-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="20" cy="16" r="3"></circle>
            </svg>
        </div>
        <div class="ws-brand-text">Worship<span> Search</span></div>
    </div>

    <nav id="ws-nav">
        <a href="@Url.Action("Index","Home")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
            Pesquisar
        </a>
        <a href="@Url.Action("Index","MusicSearch")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "MusicSearch" ? "active" : "")">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Adicionar
        </a>
        <a href="@Url.Action("Index","MusicLibrary")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "MusicLibrary" ? "active" : "")">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            Biblioteca
        </a>
        <a href="@Url.Action("Index","Escala")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Escala" ? "active" : "")">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Escala
        </a>
    </nav>

    <button id="ws-hamburger" aria-label="Menu" onclick="toggleMobileNav()">
        <svg id="ws-hamburger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
    </button>

    <div id="ws-stats">
        <div>
            <div class="ws-stat-row">
                <span class="ws-stat-label">Louvores no catálogo</span>
                <span class="ws-stat-val" id="stat-total">–</span>
            </div>
            <div style="margin-top:6px">
                <a href="@Url.Action("Index","Advanced")" style="font-size:11px;color:var(--text-dim);text-decoration:none;opacity:.6;transition:opacity .15s" onmouseover="this.style.opacity='.9'" onmouseout="this.style.opacity='.6'">avançado</a>
            </div>
        </div>
    </div>
</aside>

<main id="ws-main">
    <div id="ws-scroll">
        @if (TempData["Error"] != null)
        {
            <div class="ws-alert ws-alert-error">
                <span>@TempData["Error"]</span>
                <button class="ws-alert-close" onclick="this.parentElement.remove()">×</button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="ws-alert ws-alert-success">
                <span>@TempData["Success"]</span>
                <button class="ws-alert-close" onclick="this.parentElement.remove()">×</button>
            </div>
        }
        @RenderBody()
    </div>
</main>

<!-- Mobile nav overlay -->
<nav id="ws-nav-mobile">
    <a href="@Url.Action("Index","Home")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        Pesquisar
    </a>
    <a href="@Url.Action("Index","MusicSearch")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "MusicSearch" ? "active" : "")">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Adicionar
    </a>
    <a href="@Url.Action("Index","MusicLibrary")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "MusicLibrary" ? "active" : "")">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        Biblioteca
    </a>
    <a href="@Url.Action("Index","Escala")" class="ws-nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Escala" ? "active" : "")">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Escala
    </a>
</nav>

<!-- YouTube embed modal -->
<div id="ws-yt-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.82);align-items:center;justify-content:center;padding:20px">
    <div style="position:relative;width:min(92vw,820px)">
        <button onclick="wsCloseYt()" style="position:absolute;top:-38px;right:0;background:none;border:none;color:rgba(255,255,255,.7);cursor:pointer;font-size:26px;line-height:1;padding:4px">×</button>
        <div style="position:relative;padding-bottom:56.25%;background:#000;border-radius:12px;overflow:hidden">
            <iframe id="ws-yt-iframe" style="position:absolute;inset:0;width:100%;height:100%;border:none" allow="autoplay;encrypted-media" allowfullscreen></iframe>
        </div>
    </div>
</div>

<!-- External links modal (letras.mus.br / Cifra Club) -->
<div id="ws-ext-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.78);align-items:center;justify-content:center;padding:20px">
    <div style="background:var(--bg-card);border:1px solid var(--border-card);border-radius:16px;width:min(96vw,500px);overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5)">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border-card)">
            <div>
                <div id="ws-ext-song-title" style="font-weight:500;font-size:16px;line-height:1.3"></div>
                <div id="ws-ext-song-artist" style="color:var(--text-muted);font-size:13px;margin-top:3px"></div>
            </div>
            <button onclick="wsCloseExt()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:24px;line-height:1;padding:0;margin-left:12px;margin-top:-2px">×</button>
        </div>
        <div style="padding:16px 20px;border-bottom:1px solid var(--border-card)">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                <span style="font-weight:500;font-size:14px">letras.mus.br</span>
                <span style="font-size:11px;color:var(--text-dim);border:1px solid var(--border-card);border-radius:999px;padding:1px 7px">letras</span>
            </div>
            <div style="display:flex;gap:7px;align-items:center">
                <input id="ws-ext-letras-input" type="text" class="ws-input" readonly onclick="this.select()"
                       style="font-size:11.5px;padding:7px 10px;font-family:monospace;flex:1;min-width:0">
                <button class="ws-btn ws-btn-ghost ws-btn-sm" id="ws-ext-letras-copy" onclick="wsCopyExt('letras')" style="flex-shrink:0">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copiar
                </button>
                <a id="ws-ext-letras-link" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex-shrink:0">
                    Abrir
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
            </div>
        </div>
        <div style="padding:16px 20px;border-bottom:1px solid var(--border-card)">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5b9bd5" stroke-width="1.8" stroke-linecap="round"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                <span style="font-weight:500;font-size:14px">Cifra Club</span>
                <span style="font-size:11px;color:var(--text-dim);border:1px solid var(--border-card);border-radius:999px;padding:1px 7px">cifras</span>
            </div>
            <div style="display:flex;gap:7px;align-items:center">
                <input id="ws-ext-cifra-input" type="text" class="ws-input" readonly onclick="this.select()"
                       style="font-size:11.5px;padding:7px 10px;font-family:monospace;flex:1;min-width:0">
                <button class="ws-btn ws-btn-ghost ws-btn-sm" id="ws-ext-cifra-copy" onclick="wsCopyExt('cifra')" style="flex-shrink:0">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copiar
                </button>
                <a id="ws-ext-cifra-link" target="_blank" rel="noopener" class="ws-btn ws-btn-ghost ws-btn-sm" style="flex-shrink:0">
                    Abrir
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
            </div>
        </div>
        <div style="padding:12px 20px;display:flex;justify-content:flex-end">
            <button onclick="wsCloseExt()" class="ws-btn ws-btn-ghost ws-btn-sm">Fechar</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script>
    // Sidebar stats
    fetch('/MusicLibrary/Stats').then(r => r.json()).then(d => {
        document.getElementById('stat-total').textContent = d.total;
    }).catch(() => {});

    function toggleMobileNav() {
        var nav = document.getElementById('ws-nav-mobile');
        var icon = document.getElementById('ws-hamburger-icon');
        var open = nav.classList.toggle('open');
        icon.innerHTML = open
            ? '<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>'
            : '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>';
    }

    document.addEventListener('click', function(e) {
        var nav = document.getElementById('ws-nav-mobile');
        var side = document.getElementById('ws-side');
        if (nav.classList.contains('open') && !side.contains(e.target) && !nav.contains(e.target)) {
            nav.classList.remove('open');
            document.getElementById('ws-hamburger-icon').innerHTML = '<line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>';
        }

        // Dismissable tips
        var closeBtn = e.target.closest('[data-tip-close]');
        if (closeBtn) {
            var tipId = closeBtn.dataset.tipClose;
            var tipEl = document.querySelector('[data-tip-id="' + tipId + '"]');
            if (tipEl) tipEl.style.display = 'none';
            WsTips.dismiss(tipId, closeBtn.dataset.tipFeature || tipId);
        }

        // YouTube buttons
        var ytBtn = e.target.closest('[data-yt-url]');
        if (ytBtn) wsOpenYt(ytBtn.dataset.ytUrl);

        // Share buttons
        var shareBtn = e.target.closest('[data-share-url]');
        if (shareBtn) wsShare(shareBtn.dataset.shareUrl, shareBtn);

        // External links buttons
        var extBtn = e.target.closest('[data-ext-title]');
        if (extBtn) wsOpenExt(extBtn.dataset.extTitle, extBtn.dataset.extArtist, extBtn.dataset.extLetras);
    });

    // WsTips: dismissable tip persistence
    var WsTips = {
        _key: 'ws_tips_v1',
        _get: function() {
            try { return JSON.parse(localStorage.getItem(this._key) || '{}'); } catch(e) { return {}; }
        },
        isDismissed: function(tipId) {
            return !!this._get()[tipId];
        },
        dismiss: function(tipId, feature) {
            var data = this._get();
            data[tipId] = {
                at: new Date().toISOString(),
                feature: feature || tipId,
                device: { userAgent: navigator.userAgent, screenWidth: screen.width, platform: navigator.platform }
            };
            try { localStorage.setItem(this._key, JSON.stringify(data)); } catch(e) {}
        },
        init: function() {
            document.querySelectorAll('[data-tip-id]').forEach(function(el) {
                if (WsTips.isDismissed(el.dataset.tipId)) el.style.display = 'none';
            });
        }
    };
    document.addEventListener('DOMContentLoaded', function() { WsTips.init(); });

    // YouTube modal
    function wsOpenYt(url) {
        var match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/))([A-Za-z0-9_-]{11})/);
        if (!match) { window.open(url, '_blank'); return; }
        document.getElementById('ws-yt-iframe').src = 'https://www.youtube-nocookie.com/embed/' + match[1] + '?autoplay=1';
        document.getElementById('ws-yt-modal').style.display = 'flex';
    }
    function wsCloseYt() {
        document.getElementById('ws-yt-iframe').src = '';
        document.getElementById('ws-yt-modal').style.display = 'none';
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { wsCloseYt(); wsCloseExt(); }
    });

    // Share / copy URL
    function wsShare(url, btn) {
        if (!url) return;
        var origHtml = btn.innerHTML;
        var check = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>';
        function done() { btn.innerHTML = check; setTimeout(function() { btn.innerHTML = origHtml; }, 1600); }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done).catch(function() {
                var ta = document.createElement('textarea');
                ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select(); document.execCommand('copy');
                document.body.removeChild(ta); done();
            });
        } else {
            var ta = document.createElement('textarea');
            ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select(); document.execCommand('copy');
            document.body.removeChild(ta); done();
        }
    }

    // External links modal
    function wsOpenExt(title, artist, letrasCanonical) {
        var letrasUrl = (letrasCanonical && letrasCanonical.length > 5)
            ? letrasCanonical
            : 'https://www.letras.mus.br/pesquisar/?q=' + encodeURIComponent(((title || '') + ' ' + (artist || '')).trim());
        var cifraUrl = 'https://www.cifraclub.com.br/busca/?q=' + encodeURIComponent(((artist || '') + ' ' + (title || '')).trim());
        document.getElementById('ws-ext-song-title').textContent = title || '';
        document.getElementById('ws-ext-song-artist').textContent = artist || '';
        document.getElementById('ws-ext-letras-input').value = letrasUrl;
        document.getElementById('ws-ext-letras-link').href = letrasUrl;
        document.getElementById('ws-ext-cifra-input').value = cifraUrl;
        document.getElementById('ws-ext-cifra-link').href = cifraUrl;
        document.getElementById('ws-ext-modal').style.display = 'flex';
    }
    function wsCloseExt() {
        document.getElementById('ws-ext-modal').style.display = 'none';
    }
    function wsCopyExt(which) {
        var inputId = which === 'letras' ? 'ws-ext-letras-input' : 'ws-ext-cifra-input';
        var btnId   = which === 'letras' ? 'ws-ext-letras-copy'  : 'ws-ext-cifra-copy';
        var url = document.getElementById(inputId).value;
        var btn = document.getElementById(btnId);
        var origHtml = btn.innerHTML;
        var check = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>';
        function done() { btn.innerHTML = check; setTimeout(function() { btn.innerHTML = origHtml; }, 1600); }
        function fallback() {
            var ta = document.createElement('textarea');
            ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select(); document.execCommand('copy');
            document.body.removeChild(ta); done();
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done).catch(fallback);
        } else { fallback(); }
    }
</script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script>
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(function(){});
}
</script>
</body>
</html>
