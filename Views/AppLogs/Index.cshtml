@model List<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "Logs";
    var level  = ViewBag.Level as string ?? "";
    var evt    = ViewBag.Event as string ?? "";
    var take   = (int)(ViewBag.Take ?? 300);
    var total  = (int)(ViewBag.TotalLines ?? 0);
}

<style>
.log-row-info  { color: var(--text-sub); }
.log-row-warn  { color: #c9a857; }
.log-row-error { color: #ff8a80; }
.log-badge { display:inline-block;padding:2px 7px;border-radius:4px;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.4px; }
.log-badge-info  { background:rgba(150,200,255,.12);color:#80c4e8; }
.log-badge-warn  { background:rgba(200,160,60,.12);color:#c9a857; }
.log-badge-error { background:rgba(220,50,50,.12);color:#ff8a80; }
.log-data { font-size:12px;color:var(--text-dim);font-family:monospace;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
.log-filter-btn { cursor:pointer;padding:5px 12px;border-radius:8px;border:1px solid var(--border-card);background:var(--bg-input);color:var(--text-muted);font-family:inherit;font-size:12.5px;transition:all .12s; }
.log-filter-btn:hover,.log-filter-btn.active { border-color:var(--accent-line);color:var(--accent);background:var(--accent-soft); }
</style>

<div style="max-width:1100px;margin:0 auto" class="ws-fade">

    <div style="display:flex;align-items:center;gap:14px;margin-bottom:24px;flex-wrap:wrap">
        <div style="flex:1">
            <div class="ws-page-title">Logs do sistema</div>
            <div class="ws-page-sub">Eventos estruturados de enriquecimento e pesquisa — @total linha(s) no arquivo.</div>
        </div>
        <button class="ws-btn ws-btn-ghost ws-btn-sm" onclick="clearLogs()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
            Limpar
        </button>
        <a href="@Url.Action("Index","Logs")" class="ws-btn ws-btn-ghost ws-btn-sm">Atualizar</a>
    </div>

    <!-- Filters -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;align-items:center">
        <span style="font-size:12px;color:var(--text-dim);margin-right:4px">Nível:</span>
        <a href="@Url.Action("Index","Logs", new { evt })" class="log-filter-btn @(string.IsNullOrEmpty(level) ? "active" : "")">Todos</a>
        <a href="@Url.Action("Index","Logs", new { level = "info", evt })" class="log-filter-btn @(level == "info" ? "active" : "")">Info</a>
        <a href="@Url.Action("Index","Logs", new { level = "warn", evt })" class="log-filter-btn @(level == "warn" ? "active" : "")">Warn</a>
        <a href="@Url.Action("Index","Logs", new { level = "error", evt })" class="log-filter-btn @(level == "error" ? "active" : "")">Error</a>

        <span style="font-size:12px;color:var(--text-dim);margin-left:12px;margin-right:4px">Evento:</span>
        <form method="get" action="@Url.Action("Index","Logs")" style="display:flex;gap:6px">
            @if (!string.IsNullOrEmpty(level)) { <input type="hidden" name="level" value="@level" /> }
            <input type="text" name="evt" value="@evt" placeholder="filtrar evento…"
                   style="padding:5px 10px;border-radius:8px;border:1px solid var(--border-card);background:var(--bg-input);color:var(--text);font-family:inherit;font-size:12.5px;width:160px;outline:none" />
            <button type="submit" class="ws-btn ws-btn-ghost ws-btn-sm">Filtrar</button>
            @if (!string.IsNullOrEmpty(evt)) {
                <a href="@Url.Action("Index","Logs", new { level })" class="ws-btn ws-btn-ghost ws-btn-sm">×</a>
            }
        </form>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:60px 0;color:var(--text-muted)">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin-bottom:14px;opacity:.4"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <div>Nenhum log encontrado</div>
        </div>
    }
    else
    {
        <div class="ws-card" style="overflow:hidden">
            <table class="ws-table">
                <thead>
                    <tr>
                        <th style="width:155px">Horário</th>
                        <th style="width:60px">Nível</th>
                        <th style="width:200px">Evento</th>
                        <th>Dados</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var entry in Model)
                {
                    var lv   = entry.TryGetProperty("level", out var lvProp) ? lvProp.GetString() ?? "" : "";
                    var ts   = entry.TryGetProperty("ts",    out var tsProp) ? tsProp.GetString() ?? "" : "";
                    var evtN = entry.TryGetProperty("evt",   out var evProp) ? evProp.GetString() ?? "" : "";
                    var err  = entry.TryGetProperty("error", out var erProp) ? erProp.GetString() : null;
                    var data = entry.TryGetProperty("data",  out var daProp) ? daProp.ToString() : null;

                    var rowClass  = lv == "error" ? "log-row-error" : lv == "warn" ? "log-row-warn" : "log-row-info";
                    var badgeClass = lv == "error" ? "log-badge-error" : lv == "warn" ? "log-badge-warn" : "log-badge-info";

                    <tr class="@rowClass">
                        <td style="font-size:12px;font-family:monospace;white-space:nowrap">@ts</td>
                        <td><span class="log-badge @badgeClass">@lv</span></td>
                        <td style="font-size:13px;font-family:monospace">@evtN</td>
                        <td>
                            @if (!string.IsNullOrEmpty(err))
                            {
                                <span style="color:#ff8a80;font-size:12px">@err</span>
                            }
                            else if (!string.IsNullOrEmpty(data) && data != "null")
                            {
                                <span class="log-data" title="@data">@data</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div style="text-align:center;margin-top:14px;font-size:13px;color:var(--text-dim)">
            Exibindo @Model.Count de @total entradas
            @if (Model.Count < total)
            {
                <span> — <a href="@Url.Action("Index","Logs", new { level, evt, take = take * 2 })" style="color:var(--accent)">carregar mais</a></span>
            }
        </div>
    }

</div>

@section Scripts {
<script>
function clearLogs() {
    if (!confirm('Limpar todos os logs?')) return;
    $.ajax({ url: '@Url.Action("Clear","Logs")', method: 'POST' })
     .done(function() { location.reload(); });
}
</script>
}
