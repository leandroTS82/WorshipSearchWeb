@model WorshipSearchWeb.Models.EscalaDocument
@{
    ViewData["Title"] = (bool)ViewBag.IsNew ? "Nova Escala" : "Editar Escala";
    var docJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });
}

<style>
.escala-song-row { transition: background .12s; }
.escala-song-row:hover { background: rgba(255,255,255,.015); }
.song-result-item { padding:10px 14px; cursor:pointer; transition:background .1s; border-bottom:1px solid var(--border-card); display:flex; align-items:center; gap:12px; }
.song-result-item:last-child { border-bottom:none; }
.song-result-item:hover { background:rgba(255,255,255,.04); }
.ministro-option { padding:9px 14px; cursor:pointer; font-size:14px; transition:background .1s; }
.ministro-option:hover { background:rgba(255,255,255,.06); }
.momento-preset { padding:3px 10px; font-size:12px; border-radius:999px; cursor:pointer; background:var(--accent-soft); border:1px solid var(--accent-line); color:var(--accent); font-family:inherit; transition:background .12s, color .12s; }
.momento-preset:hover { opacity:.8; }
.momento-preset.active { background:var(--accent); border-color:var(--accent); color:#000; font-weight:600; }
.ministro-chip { padding:4px 12px; font-size:12.5px; border-radius:999px; cursor:pointer; background:rgba(255,255,255,.05); border:1px solid var(--border-card); color:var(--text-muted); font-family:inherit; transition:background .12s, border-color .12s, color .12s; }
.ministro-chip:hover { background:var(--accent-soft); border-color:var(--accent-line); color:var(--accent); }
.ministro-chip.selected { background:var(--accent-soft); border-color:var(--accent-line); color:var(--accent); font-weight:500; }
.drag-handle { opacity:.45; transition:opacity .12s; }
.escala-song-row:hover .drag-handle { opacity:.85; }
.escala-song-row.dragging { opacity:.4; background:rgba(255,255,255,.02); }
.escala-song-row.drag-over-top { border-top:2px solid var(--accent) !important; }
.escala-song-row.drag-over-bot { border-bottom:2px solid var(--accent) !important; }
#ws-toast {
    display:none; position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
    padding:10px 22px; border-radius:10px; font-size:14px; z-index:9999;
    box-shadow:0 4px 20px rgba(0,0,0,.4); white-space:nowrap;
}
.ws-toast-ok    { background:#1e3b28; border:1px solid rgba(60,180,90,.35); color:#69d18a; }
.ws-toast-error { background:#3b1a1a; border:1px solid rgba(220,50,50,.35); color:#ff8a80; }
.preview-pre { white-space:pre-wrap; font-family:'Instrument Sans',system-ui,sans-serif; font-size:13.5px; line-height:1.8; color:var(--text-sub); padding:18px; background:rgba(0,0,0,.2); border:1px solid var(--border-card); border-radius:10px; min-height:80px; }
</style>

<div style="max-width:900px;margin:0 auto" class="ws-fade">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;gap:14px;flex-wrap:wrap">
        <div>
            <div class="ws-page-title">@((bool)ViewBag.IsNew ? "Nova Escala" : "Editar Escala")</div>
            <div class="ws-page-sub">Monte a escala e copie a mensagem para o grupo de louvor</div>
        </div>
        <a href="@Url.Action("Index","Escala")" class="ws-btn ws-btn-ghost ws-btn-sm" style="margin-top:4px">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 5 5 12 12 19"/></svg>
            Minhas escalas
        </a>
    </div>

    <!-- Help tip -->
    <div data-tip-id="escala-how" style="display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:10px;background:var(--accent-soft);border:1px solid var(--accent-line);margin-bottom:20px;font-size:13.5px;line-height:1.6;color:var(--text-sub)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
            <strong style="color:var(--text)">Como usar:</strong>
            Preencha o título e a data, informe o nome do ministro, depois busque as músicas e adicione uma a uma.
            O link do YouTube é preenchido automaticamente se já estiver cadastrado. Ao terminar, clique em <strong style="color:var(--text)">Copiar</strong> para gerar a mensagem pronta para o grupo.
        </span>
        <button type="button" onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:var(--text-dim);font-size:20px;line-height:1;padding:0;margin-left:auto;flex-shrink:0">×</button>
    </div>

    <!-- Card 1: Informações básicas -->
    <div class="ws-card" style="padding:22px;margin-bottom:14px">
        <div class="ws-section-header" style="margin-top:0">
            <span class="ws-section-title">Informações da escala</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
            <div class="ws-form-group" style="margin-bottom:0">
                <label class="ws-label" for="f-titulo">Título da escala *</label>
                <input id="f-titulo" type="text" class="ws-input" placeholder="Ex: Ceia da manhã, Culto de jovens…"
                       value="@Model.Titulo" oninput="onField('titulo',this.value)">
            </div>
            <div class="ws-form-group" style="margin-bottom:0">
                <label class="ws-label" for="f-data">Data *</label>
                <div style="position:relative">
                    <input id="f-data" type="text" class="ws-input" placeholder="dd/MM/yyyy" maxlength="10"
                           style="padding-right:40px"
                           value="@(string.IsNullOrWhiteSpace(Model.Data) ? "" : (System.DateTime.TryParse(Model.Data, out var _dt) ? _dt.ToString("dd/MM/yyyy") : Model.Data))"
                           oninput="onDataInput(this.value)">
                    <button type="button" onclick="document.getElementById('f-data-picker').showPicker()"
                            title="Abrir calendário"
                            style="position:absolute;right:0;top:0;bottom:0;width:38px;background:none;border:none;cursor:pointer;color:var(--text-muted);display:flex;align-items:center;justify-content:center;border-left:1px solid var(--border-card);border-radius:0 10px 10px 0;transition:color .12s,background .12s">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </button>
                    <input type="date" id="f-data-picker"
                           style="position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;top:0;left:0"
                           oninput="onDatePicker(this.value)">
                </div>
            </div>
        </div>
        <div style="margin-top:16px;position:relative" id="ministro-wrap">
            <label class="ws-label" for="f-ministro">Nome do ministro *</label>
            <input id="f-ministro" type="text" class="ws-input" placeholder="Digite o nome do ministro ou ministra…"
                   value="@Model.Ministro" autocomplete="off"
                   oninput="onMinistroInput(this.value)">
            <div id="ministro-chips" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px"></div>
        </div>
        <div style="margin-top:16px">
            <label class="ws-label" for="f-obs">Observação / saudação inicial (opcional)</label>
            <textarea id="f-obs" class="ws-input" rows="2"
                      placeholder="Ex: A paz pessoal. Seguem os louvores de quinta-feira. — Se vazio, usa saudação padrão."
                      oninput="onField('observacao',this.value)">@Model.Observacao</textarea>
            <div style="font-size:12px;color:var(--text-dim);margin-top:4px">
                Se vazio, a mensagem começa diretamente com a data e título.
            </div>
        </div>
    </div>

    <!-- Card 2: Músicas -->
    <div class="ws-card" style="padding:22px;margin-bottom:14px">
        <div class="ws-section-header" style="margin-top:0">
            <span class="ws-section-title">Músicas da escala</span>
            <span style="font-size:12.5px;color:var(--text-dim)" id="song-count-label">0 música(s)</span>
        </div>

        <!-- Search box -->
        <div style="position:relative;margin-bottom:8px">
            <svg style="position:absolute;left:13px;top:50%;transform:translateY(-50%);pointer-events:none" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
            <input id="song-search" type="text" class="ws-input" style="padding-left:40px"
                   placeholder="Buscar música na biblioteca (título ou artista)…"
                   autocomplete="off" oninput="onSongSearch(this.value)">
        </div>
        <div id="song-results" style="border-radius:10px;overflow:hidden;border:1px solid var(--border-card);margin-bottom:16px;display:none"></div>

        <!-- Song list -->
        <div id="song-list"></div>
    </div>

    <!-- Card 3: Pré-visualização -->
    <div style="border-radius:14px;border:1px solid rgba(214,145,95,.35);background:linear-gradient(135deg,rgba(214,145,95,.07) 0%,rgba(0,0,0,.15) 100%);padding:22px;margin-bottom:20px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:10px">
                <div style="width:32px;height:32px;border-radius:8px;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <div>
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                        <span style="font-weight:600;font-size:14px;color:var(--text)">Mensagem para o grupo</span>
                        <span id="rascunho-badge" style="display:none;padding:2px 10px;border-radius:999px;font-size:11.5px;font-weight:500;background:rgba(200,160,60,.12);border:1px solid rgba(200,160,60,.3);color:#c9a857">Rascunho · escala ainda não finalizada</span>
                    </div>
                    <div style="font-size:12px;color:var(--text-dim)">Atualiza automaticamente enquanto você edita</div>
                </div>
            </div>
            <button type="button" onclick="doCopy()" class="ws-btn ws-btn-primary ws-btn-sm">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copiar mensagem
            </button>
        </div>
        <div id="preview-text" class="preview-pre" style="background:rgba(0,0,0,.25);border-color:rgba(214,145,95,.2);font-size:14px;line-height:1.85"></div>
    </div>

    <!-- Action buttons -->
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px">
        <button id="btn-save-close" type="button" onclick="doSaveClose()" class="ws-btn ws-btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13"/><polyline points="7 3 7 8 15 8"/></svg>
            Salvar e continuar depois
        </button>
        <button id="btn-save-copy" type="button" onclick="doSaveCopy()" class="ws-btn ws-btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Salvar e copiar mensagem
        </button>
        <button id="btn-save" type="button" onclick="doSave()" class="ws-btn ws-btn-ghost">
            Salvar
        </button>
        <button type="button" onclick="doCopy()" class="ws-btn ws-btn-ghost">
            Copiar mensagem
        </button>
    </div>
</div>

<div id="ws-toast"></div>

@section Scripts {
<script>
var escalaDoc = @Html.Raw(docJson);
var isNew     = @((bool)ViewBag.IsNew ? "true" : "false");
var saveUrl   = '@Url.Action("Save","Escala")';
var indexUrl  = '@Url.Action("Index","Escala")';
var searchUrl = '@Url.Action("SearchSongs","Escala")';
var ministrosUrl = '@Url.Action("Ministros","Escala")';

var allMinistros = [];
var searchTimer  = null;

// ── Field sync ────────────────────────────────────────────────────────────────

function onField(key, val) {
    escalaDoc[key] = val;
    updatePreview();
}

function onDatePicker(iso) {
    // iso = "yyyy-MM-dd" from native date input
    if (!iso) return;
    var parts = iso.split('-');
    if (parts.length !== 3) return;
    var display = parts[2] + '/' + parts[1] + '/' + parts[0];
    document.getElementById('f-data').value = display;
    escalaDoc.data = iso;
    updatePreview();
}

function onDataInput(v) {
    // Auto-insert slashes: 2 digits / 2 digits / 4 digits
    v = v.replace(/\D/g, '');
    if (v.length > 2) v = v.slice(0,2) + '/' + v.slice(2);
    if (v.length > 5) v = v.slice(0,5) + '/' + v.slice(5,9);
    var el = document.getElementById('f-data');
    el.value = v;
    // Store as ISO yyyy-MM-dd if complete
    var parts = v.split('/');
    if (parts.length === 3 && parts[2].length === 4) {
        var iso = parts[2] + '-' + parts[1] + '-' + parts[0];
        escalaDoc.data = iso;
        document.getElementById('f-data-picker').value = iso;
    } else {
        escalaDoc.data = v;
    }
    updatePreview();
}

// ── Minister autocomplete ────────────────────────────────────────────────────

async function loadMinistros() {
    if (allMinistros.length) return;
    try {
        var r = await fetch(ministrosUrl);
        allMinistros = await r.json();
        renderMinistroChips();
    } catch(e) {}
}

function renderMinistroChips() {
    var container = document.getElementById('ministro-chips');
    if (!container || !allMinistros.length) return;
    var current = document.getElementById('f-ministro').value.trim();
    container.innerHTML = allMinistros.map(function(m) {
        var active = m === current;
        return '<button type="button" class="ministro-chip' + (active ? ' selected' : '') + '" onclick="selectMinistro(\'' + m.replace(/\\/g,'\\\\').replace(/'/g,"\\'") + '\')">' + escText(m) + '</button>';
    }).join('');
}

function escText(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function onMinistroInput(v) {
    escalaDoc.ministro = v;
    loadMinistros().then(renderMinistroChips);
}

function selectMinistro(name) {
    document.getElementById('f-ministro').value = name;
    escalaDoc.ministro = name;
    renderMinistroChips();
    updatePreview();
}

// ── Song search ───────────────────────────────────────────────────────────────

function onSongSearch(v) {
    clearTimeout(searchTimer);
    var el = document.getElementById('song-results');
    if (!v || v.length < 2) { el.style.display = 'none'; el.innerHTML = ''; return; }
    searchTimer = setTimeout(function() { doSearch(v); }, 280);
}

async function doSearch(q) {
    var el = document.getElementById('song-results');
    el.innerHTML = '<div style="padding:12px 14px;color:var(--text-dim);font-size:13.5px">Buscando…</div>';
    el.style.display = 'block';
    try {
        var r = await fetch(searchUrl + '?q=' + encodeURIComponent(q));
        var songs = await r.json();
        if (!songs.length) {
            el.innerHTML = '<div style="padding:12px 14px;color:var(--text-dim);font-size:13.5px">Nenhuma música encontrada na biblioteca. <a href="' + '@Url.Action("Index","MusicSearch")' + '" style="color:var(--accent)">Adicionar música</a></div>';
            return;
        }
        el.innerHTML = songs.map(function(s) {
            var ytIcon = s.youtubeUrl
                ? '<svg width="12" height="12" viewBox="0 0 24 24" fill="#ff4e4e" style="flex-shrink:0" xmlns="http://www.w3.org/2000/svg"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="white" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>'
                : '';
            return '<div class="song-result-item" onclick="addSong(' + esc(JSON.stringify(s)) + ')">'
                + '<div style="flex:1;min-width:0"><div style="font-weight:500;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + esc(s.titulo) + '</div>'
                + '<div style="font-size:12.5px;color:var(--text-muted)">' + esc(s.artista) + '</div></div>'
                + ytIcon
                + '<span class="ws-btn ws-btn-ghost ws-btn-sm" style="pointer-events:none;font-size:12px">+ Adicionar</span></div>';
        }).join('');
    } catch(e) {
        el.innerHTML = '<div style="padding:12px 14px;color:#ff8a80;font-size:13.5px">Erro ao buscar músicas.</div>';
    }
}

// ── Song list management ──────────────────────────────────────────────────────

function addSong(song) {
    if (!escalaDoc.musicas) escalaDoc.musicas = [];
    if (escalaDoc.musicas.find(function(m) { return m.file_name === song.fileName; })) {
        showToast('Música já adicionada na escala', 'error'); return;
    }
    var ytUrl = song.youtubeUrl || '';
    if (!ytUrl && song.youtubeId) ytUrl = 'https://youtu.be/' + song.youtubeId;
    escalaDoc.musicas.push({
        file_name: song.fileName,
        titulo: song.titulo,
        artista: song.artista,
        youtube_url: ytUrl,
        momento: '',
        obs: ''
    });
    document.getElementById('song-search').value = '';
    var el = document.getElementById('song-results');
    el.style.display = 'none'; el.innerHTML = '';
    renderSongs();
    updatePreview();
}

function removeSong(idx) {
    escalaDoc.musicas.splice(idx, 1);
    renderSongs();
    updatePreview();
}

// ── Drag & drop reorder ───────────────────────────────────────────────────────

var dragSrcIdx = null;

function onDragStart(e, idx) {
    dragSrcIdx = idx;
    e.dataTransfer.effectAllowed = 'move';
    setTimeout(function() {
        var rows = document.querySelectorAll('.escala-song-row');
        if (rows[idx]) rows[idx].classList.add('dragging');
    }, 0);
}

function onDragEnd(e) {
    dragSrcIdx = null;
    document.querySelectorAll('.escala-song-row').forEach(function(r) {
        r.classList.remove('dragging', 'drag-over-top', 'drag-over-bot');
    });
}

function onDragOver(e, idx) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    document.querySelectorAll('.escala-song-row').forEach(function(r) {
        r.classList.remove('drag-over-top', 'drag-over-bot');
    });
    if (dragSrcIdx === null || dragSrcIdx === idx) return;
    var rows = document.querySelectorAll('.escala-song-row');
    if (rows[idx]) {
        rows[idx].classList.add(idx < dragSrcIdx ? 'drag-over-top' : 'drag-over-bot');
    }
}

function onDrop(e, idx) {
    e.preventDefault();
    if (dragSrcIdx === null || dragSrcIdx === idx) return;
    var item = escalaDoc.musicas.splice(dragSrcIdx, 1)[0];
    escalaDoc.musicas.splice(idx, 0, item);
    renderSongs();
    updatePreview();
}

function updateSongField(idx, field, val) {
    escalaDoc.musicas[idx][field] = val;
    updatePreview();
}

function setSongMomento(idx, val) {
    var cur = (escalaDoc.musicas[idx].momento || '').trim();
    var newVal = (cur === val) ? '' : val;
    escalaDoc.musicas[idx].momento = newVal;
    var inp = document.getElementById('mom-' + idx);
    if (inp) inp.value = newVal;
    var rows = document.querySelectorAll('.escala-song-row');
    if (rows[idx]) {
        rows[idx].querySelectorAll('.momento-preset').forEach(function(btn) {
            btn.classList.toggle('active', btn.textContent.trim() === newVal);
        });
    }
    updatePreview();
}

function renderSongs() {
    var el = document.getElementById('song-list');
    var count = escalaDoc.musicas.length;
    document.getElementById('song-count-label').textContent = count + ' música(s)';
    if (!count) {
        el.innerHTML = '<div style="text-align:center;padding:32px 20px;color:var(--text-dim);font-size:14px;border:1px dashed var(--border-card);border-radius:10px">Use a busca acima para adicionar músicas à escala.</div>';
        return;
    }
    var presets = ['Ceia', 'Oferta', 'Apelo'];
    el.innerHTML = escalaDoc.musicas.map(function(m, i) {
        var isLast  = i === count - 1;
        var ytUrl   = (m.youtube_url || '').trim();
        var ytSearch = 'https://www.youtube.com/results?search_query=' + encodeURIComponent((m.titulo || '') + ' ' + (m.artista || ''));
        var presetsHtml = presets.map(function(p) {
            var active = (m.momento || '').trim() === p;
            return '<button type="button" class="momento-preset' + (active ? ' active' : '') + '" onclick="setSongMomento(' + i + ',\'' + p + '\')">' + esc(p) + '</button>';
        }).join('');

        var ytBlock = '';
        if (ytUrl) {
            ytBlock = '<div>'
                + '<label class="ws-label" style="display:block">Link YouTube</label>'
                + '<input type="url" class="ws-input" id="yt-' + i + '" style="font-size:13px;padding:8px 12px" value="' + esc(ytUrl) + '" placeholder="https://youtu.be/…" oninput="updateSongField(' + i + ',\'youtube_url\',this.value)">'
                + '</div>';
        } else {
            ytBlock = '<div>'
                + '<label class="ws-label" style="display:block">Link YouTube</label>'
                + '<input type="url" class="ws-input" id="yt-' + i + '" style="font-size:13px;padding:8px 12px;margin-bottom:6px" value="" placeholder="https://youtu.be/…" oninput="updateSongField(' + i + ',\'youtube_url\',this.value)">'
                + '<div style="display:flex;align-items:center;gap:7px;padding:7px 10px;border-radius:8px;background:rgba(200,160,60,.07);border:1px solid rgba(200,160,60,.2)">'
                + '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c9a857" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
                + '<span style="font-size:12px;color:#c9a857;flex:1">Sem link ainda. <a href="' + esc(ytSearch) + '" target="_blank" rel="noopener" style="color:var(--accent);font-weight:500">Buscar no YouTube ↗</a> e cole o link aqui para que nas próximas escalas já venha preenchido.</span>'
                + '</div>'
                + '</div>';
        }

        return '<div class="escala-song-row" data-idx="' + i + '" draggable="true"'
            + ' ondragstart="onDragStart(event,' + i + ')"'
            + ' ondragend="onDragEnd(event)"'
            + ' ondragover="onDragOver(event,' + i + ')"'
            + ' ondrop="onDrop(event,' + i + ')"'
            + ' style="border-bottom:' + (isLast ? 'none' : '1px solid var(--border-card)') + ';padding:14px 16px">'

            // Row header: drag handle + number + title + remove
            + '<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">'
            + '<div class="drag-handle" title="Arrastar para reordenar" style="cursor:grab;color:var(--text-dim);flex-shrink:0;padding:2px 4px;touch-action:none">'
            + '<svg width="16" height="20" viewBox="0 0 16 20" fill="currentColor"><circle cx="5" cy="4" r="1.5"/><circle cx="11" cy="4" r="1.5"/><circle cx="5" cy="10" r="1.5"/><circle cx="11" cy="10" r="1.5"/><circle cx="5" cy="16" r="1.5"/><circle cx="11" cy="16" r="1.5"/></svg>'
            + '</div>'
            + '<div style="width:24px;height:24px;border-radius:50%;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:600;color:var(--accent)">' + (i + 1) + '</div>'
            + '<div style="flex:1;min-width:0">'
            + '<div style="font-weight:500;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(m.titulo) + '</div>'
            + '<div style="font-size:13px;color:var(--text-muted)">' + esc(m.artista) + '</div>'
            + '</div>'
            + '<button type="button" class="ws-btn ws-btn-danger ws-btn-sm" onclick="removeSong(' + i + ')" title="Remover música" style="flex-shrink:0">'
            + '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
            + '</button></div>'

            // Observação + YouTube
            + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">'
            + '<div><label class="ws-label" style="display:block">Observação <span style="color:var(--text-dim)">(opcional — ex: Tom A)</span></label>'
            + '<input type="text" class="ws-input" style="font-size:13px;padding:8px 12px" value="' + esc(m.obs || '') + '" placeholder="Tom A, Tom original…" oninput="updateSongField(' + i + ',\'obs\',this.value)"></div>'
            + ytBlock
            + '</div>'

            // Momento
            + '<div><label class="ws-label">Seção na escala <span style="color:var(--text-dim)">(opcional — agrupa músicas por momento)</span></label>'
            + '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px">' + presetsHtml + '</div>'
            + '<input type="text" id="mom-' + i + '" class="ws-input" style="font-size:13px;padding:8px 12px" value="' + esc(m.momento || '') + '" placeholder="Ex: Ceia, Oferta, Apelo…" oninput="updateSongField(' + i + ',\'momento\',this.value)"></div>'

            + '</div>';
    }).join('');
}

// ── Preview & copy text ───────────────────────────────────────────────────────

function formatDate(dateStr) {
    if (!dateStr) return '';
    // Accept yyyy-MM-dd or dd/MM/yyyy
    var d;
    if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
        d = new Date(dateStr + 'T12:00:00');
    } else if (/^\d{2}\/\d{2}\/\d{4}$/.test(dateStr)) {
        var p = dateStr.split('/');
        d = new Date(p[2] + '-' + p[1] + '-' + p[0] + 'T12:00:00');
    } else {
        return dateStr;
    }
    if (isNaN(d)) return dateStr;
    var days = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
    var dd = String(d.getDate()).padStart(2, '0');
    var mm = String(d.getMonth() + 1).padStart(2, '0');
    return days[d.getDay()] + ' dia ' + dd + '/' + mm;
}

function generateText() {
    var lines = [];
    var obs = (escalaDoc.observacao || '').trim();
    if (obs) { lines.push(obs); lines.push(''); }
    if (escalaDoc.data) {
        var dateLabel = formatDate(escalaDoc.data);
        var titleLabel = (escalaDoc.titulo || '').trim().toLowerCase();
        lines.push(dateLabel + (titleLabel ? ' ' + titleLabel : ''));
        lines.push('');
    }
    var curMomento = null;
    (escalaDoc.musicas || []).forEach(function(m) {
        var mom = (m.momento || '').trim();
        if (mom && mom !== curMomento) {
            if (curMomento !== null) lines.push('');
            lines.push(mom + ':');
            curMomento = mom;
        }
        var songLine = (m.titulo || '') + ' - ' + (m.artista || '');
        if (m.obs) songLine += ' (' + m.obs + ')';
        var ytUrl = (m.youtube_url || '').trim();
        lines.push(ytUrl ? songLine + ':' : songLine);
        if (ytUrl) lines.push(ytUrl);
        lines.push('');
    });
    return lines.join('\n').replace(/\n{3,}/g, '\n\n').trimEnd();
}

function updateRascunhoBadge() {
    var badge = document.getElementById('rascunho-badge');
    if (badge) badge.style.display = escalaDoc.rascunho ? '' : 'none';
}

function updatePreview() {
    document.getElementById('preview-text').textContent = generateText();
    updateRascunhoBadge();
}

function doCopy() {
    var text = generateText();
    if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(function() { showToast('Mensagem copiada!', 'ok'); });
    } else {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta);
        showToast('Mensagem copiada!', 'ok');
    }
}

// ── Save actions ──────────────────────────────────────────────────────────────

function collectForm() {
    escalaDoc.titulo     = document.getElementById('f-titulo').value.trim();
    escalaDoc.ministro   = document.getElementById('f-ministro').value.trim();
    escalaDoc.observacao = document.getElementById('f-obs').value.trim();
    // data is already kept in sync by onDataInput; only fall back to field value if not set
    if (!escalaDoc.data) escalaDoc.data = document.getElementById('f-data').value;
}

async function saveEscala(btnId, rascunho) {
    collectForm();
    escalaDoc.rascunho = (rascunho !== false);
    updateRascunhoBadge();
    if (!escalaDoc.titulo)    { showToast('Preencha o título da escala', 'error'); return false; }
    if (!escalaDoc.data)      { showToast('Informe a data da escala', 'error'); return false; }
    if (!escalaDoc.ministro)  { showToast('Informe o nome do ministro', 'error'); return false; }

    var btn = document.getElementById(btnId);
    var orig = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="ws-spinner" style="width:14px;height:14px;border-width:2px"></span>'; }

    try {
        var r = await fetch(saveUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(escalaDoc)
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        var data = await r.json();
        if (!data.success) throw new Error('Falha ao salvar');
        escalaDoc.id = data.id;
        isNew = false;
        showToast('Escala salva!', 'ok');
        return true;
    } catch(e) {
        showToast('Erro ao salvar: ' + e.message, 'error');
        return false;
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = orig; }
    }
}

async function doSave() {
    await saveEscala('btn-save', true);
}

async function doSaveClose() {
    if (await saveEscala('btn-save-close', true))
        window.location.href = indexUrl;
}

async function doSaveCopy() {
    if (await saveEscala('btn-save-copy', false)) {
        doCopy();
        setTimeout(function() { window.location.href = indexUrl; }, 600);
    }
}

// ── Toast ─────────────────────────────────────────────────────────────────────

function showToast(msg, type) {
    var t = document.getElementById('ws-toast');
    t.textContent = msg;
    t.className = type === 'ok' ? 'ws-toast-ok' : 'ws-toast-error';
    t.style.display = 'block';
    clearTimeout(t._hide);
    t._hide = setTimeout(function() { t.style.display = 'none'; }, 2600);
}

// ── HTML escape ───────────────────────────────────────────────────────────────

function esc(s) {
    if (typeof s !== 'string') return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#x27;');
}

// ── Init ──────────────────────────────────────────────────────────────────────

document.addEventListener('DOMContentLoaded', function() {
    if (!escalaDoc.musicas) escalaDoc.musicas = [];
    // Sync native date picker with already-loaded ISO date
    if (escalaDoc.data && /^\d{4}-\d{2}-\d{2}$/.test(escalaDoc.data))
        document.getElementById('f-data-picker').value = escalaDoc.data;
    loadMinistros();
    renderSongs();
    updatePreview();
    updateRascunhoBadge();
});
</script>
}
