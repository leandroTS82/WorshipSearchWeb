@model List<WorshipSearchWeb.Models.EscalaDocument>
@{
    ViewData["Title"] = "Escalas";

    var groups = Model
        .GroupBy(d => string.IsNullOrEmpty(d.Data) || d.Data.Length < 7 ? "0000-00" : d.Data[..7])
        .OrderByDescending(g => g.Key)
        .ToList();

    string MonthLabel(string ym)
    {
        string[] months = { "", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
                            "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
        if (ym == "0000-00") return "Sem data";
        if (System.DateOnly.TryParse(ym + "-01", out var d))
            return months[d.Month] + " " + d.Year;
        return ym;
    }

    string DayLabel(string iso)
    {
        if (!System.DateOnly.TryParse(iso, out var d)) return iso;
        string[] days = { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" };
        return days[(int)d.DayOfWeek] + " " + d.ToString("dd/MM/yyyy");
    }
}

<style>
.escala-card {
    display:flex; align-items:center; gap:16px;
    padding:14px 18px;
    border-bottom:1px solid var(--border-card);
    transition:background .12s;
}
.escala-card:last-child { border-bottom:none; }
.escala-card:hover { background:rgba(255,255,255,.02); }
.escala-date-badge {
    min-width:90px; text-align:center;
    padding:6px 10px; border-radius:8px;
    background:var(--accent-soft); border:1px solid var(--accent-line);
    font-size:12px; line-height:1.4; color:var(--accent); flex-shrink:0;
}
</style>

<div style="max-width:960px;margin:0 auto" class="ws-fade">

    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:14px">
        <div>
            <div class="ws-page-title">Escalas de Louvor</div>
            <div class="ws-page-sub">Escalas salvas para compartilhar com a equipe de louvor</div>
        </div>
        <a href="@Url.Action("Edit","Escala")" class="ws-btn ws-btn-primary ws-btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nova escala
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:72px 0;color:var(--text-muted)">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin-bottom:18px;opacity:.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <div style="font-size:16px;margin-bottom:10px">Nenhuma escala ainda</div>
            <div style="font-size:14px;margin-bottom:20px">Crie a primeira escala de louvores para o grupo.</div>
            <a href="@Url.Action("Edit","Escala")" class="ws-btn ws-btn-primary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Criar primeira escala
            </a>
        </div>
    }
    else
    {
        foreach (var group in groups)
        {
            <div style="margin-bottom:28px">
                <div style="font-size:11.5px;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);margin-bottom:10px;padding:0 2px">
                    @MonthLabel(group.Key)
                </div>
                <div class="ws-card" style="overflow:hidden">
                    @foreach (var doc in group.OrderByDescending(d => d.Data))
                    {
                        <div class="escala-card">
                            <div class="escala-date-badge">
                                @if (!string.IsNullOrEmpty(doc.Data) && System.DateOnly.TryParse(doc.Data, out var dt))
                                {
                                    string[] days = { "DOM", "SEG", "TER", "QUA", "QUI", "SEX", "SÁB" };
                                    <div style="font-weight:600;font-size:13px">@dt.ToString("dd/MM")</div>
                                    <div style="font-size:11px;opacity:.8">@days[(int)dt.DayOfWeek]</div>
                                }
                                else
                                {
                                    <div style="font-size:11px;opacity:.7">sem data</div>
                                }
                            </div>

                            <div style="flex:1;min-width:0">
                                <div style="font-weight:500;font-size:15px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    @(string.IsNullOrEmpty(doc.Titulo) ? "(sem título)" : doc.Titulo)
                                </div>
                                <div style="font-size:12.5px;color:var(--text-dim);display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                                    @if (!string.IsNullOrEmpty(doc.Ministro))
                                    {
                                        <span>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="vertical-align:middle"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                                            @doc.Ministro
                                        </span>
                                    }
                                    @if (doc.Musicas?.Count > 0)
                                    {
                                        <span>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="vertical-align:middle"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                            @doc.Musicas.Count música(s)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div style="display:flex;gap:6px;flex-shrink:0">
                                <button class="ws-btn ws-btn-ghost ws-btn-sm copy-escala-btn"
                                        data-id="@doc.Id" title="Copiar mensagem">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                    <span class="d-copy-label">Copiar</span>
                                </button>
                                <a href="@Url.Action("Edit","Escala", new { id = doc.Id })"
                                   class="ws-btn ws-btn-ghost ws-btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="ws-btn ws-btn-danger ws-btn-sm delete-escala-btn"
                                        data-id="@doc.Id" title="Excluir">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Copy text modal -->
<div id="copy-modal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.7);align-items:center;justify-content:center;padding:20px">
    <div style="background:var(--bg-card);border:1px solid var(--border-card);border-radius:14px;width:min(96vw,540px);max-height:80vh;display:flex;flex-direction:column">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--border-card)">
            <div style="font-weight:500;font-size:15px">Mensagem gerada</div>
            <button onclick="closeCopyModal()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:22px;line-height:1">×</button>
        </div>
        <pre id="copy-modal-text" style="flex:1;overflow:auto;padding:18px 20px;font-family:inherit;font-size:13.5px;white-space:pre-wrap;line-height:1.75;color:var(--text-sub);margin:0"></pre>
        <div style="padding:14px 20px;border-top:1px solid var(--border-card);display:flex;gap:10px">
            <button id="do-copy-btn" onclick="doModalCopy()" class="ws-btn ws-btn-primary" style="flex:1">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copiar para área de transferência
            </button>
            <button onclick="closeCopyModal()" class="ws-btn ws-btn-ghost">Fechar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
var copyUrl    = '@Url.Action("CopyText","Escala")';
var deleteUrl  = '@Url.Action("Delete","Escala")';

document.querySelectorAll('.copy-escala-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
        var id = this.dataset.id;
        var label = this.querySelector('.d-copy-label');
        label.textContent = '…';
        try {
            var r = await fetch(copyUrl + '?id=' + encodeURIComponent(id));
            var text = await r.text();
            document.getElementById('copy-modal-text').textContent = text;
            document.getElementById('copy-modal').style.display = 'flex';
        } catch(e) { alert('Erro ao carregar texto.'); }
        label.textContent = 'Copiar';
    });
});

function closeCopyModal() {
    document.getElementById('copy-modal').style.display = 'none';
}

function doModalCopy() {
    var text = document.getElementById('copy-modal-text').textContent;
    var btn  = document.getElementById('do-copy-btn');
    var orig = btn.innerHTML;
    if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(done);
    } else {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta); done();
    }
    function done() {
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Copiado!';
        setTimeout(function() { btn.innerHTML = orig; }, 2000);
    }
}

document.querySelectorAll('.delete-escala-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        if (!confirm('Excluir esta escala?')) return;
        var id = this.dataset.id;
        var row = this.closest('.escala-card');
        fetch(deleteUrl + '?id=' + encodeURIComponent(id), { method: 'DELETE' })
            .then(function() { row.style.transition = 'opacity .25s'; row.style.opacity = '0'; setTimeout(function() { row.remove(); }, 260); })
            .catch(function() { alert('Erro ao excluir.'); });
    });
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCopyModal();
});
</script>
}
