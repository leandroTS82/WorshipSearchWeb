@model List<WorshipSearchWeb.Models.EscalaDocument>
@{
    ViewData["Title"] = "Escalas";

    var today = System.DateOnly.FromDateTime(DateTime.Today);

    // Sort: future/today first (ascending), then past (descending), then no-date
    var sorted = Model
        .OrderBy(d => {
            if (!System.DateOnly.TryParse(d.Data, out var dt)) return 2;
            return dt >= today ? 0 : 1;
        })
        .ThenBy(d => {
            if (!System.DateOnly.TryParse(d.Data, out var dt)) return System.DateOnly.MaxValue;
            return d.Data != null && System.DateOnly.TryParse(d.Data, out var dt2) && dt2 >= today
                ? dt2  // future: ascending
                : System.DateOnly.MaxValue.AddDays(-(dt.DayNumber)); // past: descending
        })
        .ToList();

    // Find next upcoming escala
    var nextId = sorted.FirstOrDefault(d =>
        System.DateOnly.TryParse(d.Data, out var dt) && dt >= today)?.Id ?? "";

    var groups = sorted
        .GroupBy(d => string.IsNullOrEmpty(d.Data) || d.Data.Length < 7 ? "0000-00" : d.Data[..7])
        .OrderBy(g => {
            if (g.Key == "0000-00") return "9999-99";
            // Groups with any future escala come first, past groups after
            var hasUpcoming = g.Any(d => System.DateOnly.TryParse(d.Data, out var dt) && dt >= today);
            return hasUpcoming ? "0" + g.Key : "1" + g.Key.Replace("-","") is var k ? "1" + g.Key : "1" + g.Key;
        })
        .ThenByDescending(g => g.Key)
        .ToList();

    string MonthLabel(string ym)
    {
        string[] months = { "", "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
                            "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
        if (ym == "0000-00") return "Sem data";
        if (System.DateOnly.TryParse(ym + "-01", out var d))
            return months[d.Month] + " " + d.Year;
        return ym;
    }
}

<style>
.month-header {
    display:flex; align-items:center; justify-content:space-between;
    cursor:pointer; user-select:none;
    padding:6px 4px; margin-bottom:10px; border-radius:8px;
    transition:background .12s;
}
.month-header:hover { background:rgba(255,255,255,.03); }
.month-chevron { transition:transform .2s; color:var(--text-dim); flex-shrink:0; }
.month-body { overflow:hidden; transition:max-height .25s ease, opacity .2s; }
.month-body.collapsed { max-height:0 !important; opacity:0; pointer-events:none; }

.escala-card {
    display:flex; align-items:center; gap:16px;
    padding:14px 18px;
    border-bottom:1px solid var(--border-card);
    transition:background .12s;
}
.escala-card:last-child { border-bottom:none; }
.escala-card:hover { background:rgba(255,255,255,.02); }
.escala-card.is-past { opacity:.55; }
.escala-card.is-past:hover { opacity:.75; }
.escala-card.is-next {
    background:rgba(214,145,95,.05);
    border-left:3px solid var(--accent);
    padding-left:15px;
}
.escala-date-badge {
    min-width:90px; text-align:center;
    padding:6px 10px; border-radius:8px;
    background:var(--accent-soft); border:1px solid var(--accent-line);
    font-size:12px; line-height:1.4; color:var(--accent); flex-shrink:0;
}
</style>

<div style="max-width:960px;margin:0 auto" class="ws-fade">

    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:14px">
        <div>
            <div class="ws-page-title">Escalas de Louvor</div>
            <div class="ws-page-sub">Escalas salvas para compartilhar com a equipe de louvor</div>
        </div>
        <a href="@Url.Action("Edit","Escala")" class="ws-btn ws-btn-primary ws-btn-sm">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nova escala
        </a>
    </div>

    @if (!Model.Any())
    {
        <div style="text-align:center;padding:72px 0;color:var(--text-muted)">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" style="margin-bottom:18px;opacity:.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <div style="font-size:16px;margin-bottom:10px">Nenhuma escala ainda</div>
            <div style="font-size:14px;margin-bottom:20px">Crie a primeira escala de louvores para o grupo.</div>
            <a href="@Url.Action("Edit","Escala")" class="ws-btn ws-btn-primary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Criar primeira escala
            </a>
        </div>
    }
    else
    {
        foreach (var group in groups)
        {
            var groupKey = group.Key;
            <div style="margin-bottom:24px" data-month-group="@groupKey">
                <div class="month-header" onclick="toggleMonth('@groupKey', this)">
                    <span style="font-size:11.5px;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim);font-weight:600">
                        @MonthLabel(group.Key)
                        <span style="font-weight:400;opacity:.6;margin-left:6px">(@group.Count())</span>
                    </span>
                    <svg class="month-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
                <div class="month-body" data-month-body="@groupKey">
                <div class="ws-card" style="overflow:hidden">
                    @foreach (var doc in group)
                    {
                        var isPast   = System.DateOnly.TryParse(doc.Data, out var docDate) && docDate < today;
                        var isNext   = doc.Id == nextId;
                        var cardCls  = "escala-card" + (isPast ? " is-past" : "") + (isNext ? " is-next" : "");
                        <div class="@cardCls">
                            <div class="escala-date-badge">
                                @if (!string.IsNullOrEmpty(doc.Data) && System.DateOnly.TryParse(doc.Data, out var dt))
                                {
                                    string[] days = { "DOM", "SEG", "TER", "QUA", "QUI", "SEX", "SÁB" };
                                    <div style="font-weight:600;font-size:13px">@dt.ToString("dd/MM")</div>
                                    <div style="font-size:11px;opacity:.8">@days[(int)dt.DayOfWeek]</div>
                                }
                                else
                                {
                                    <div style="font-size:11px;opacity:.7">sem data</div>
                                }
                            </div>

                            <div style="flex:1;min-width:0">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;min-width:0">
                                    <div style="font-weight:500;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        @(string.IsNullOrEmpty(doc.Titulo) ? "(sem título)" : doc.Titulo)
                                    </div>
                                    @if (isNext)
                                    {
                                        <span style="flex-shrink:0;font-size:11px;padding:2px 8px;border-radius:999px;background:var(--accent-soft);border:1px solid var(--accent-line);color:var(--accent);white-space:nowrap;font-weight:600">
                                            próxima
                                        </span>
                                    }
                                    else if (isPast)
                                    {
                                        <span style="flex-shrink:0;font-size:11px;padding:2px 8px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid var(--border-card);color:var(--text-dim);white-space:nowrap">
                                            passada
                                        </span>
                                    }
                                    else if (doc.Rascunho)
                                    {
                                        <span style="flex-shrink:0;font-size:11px;padding:2px 8px;border-radius:999px;background:rgba(200,160,50,.12);border:1px solid rgba(200,160,50,.28);color:#c9a857;white-space:nowrap;font-weight:500">
                                            em andamento
                                        </span>
                                    }
                                </div>
                                <div style="font-size:12.5px;color:var(--text-dim);display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                                    @if (!string.IsNullOrEmpty(doc.Ministro))
                                    {
                                        <span>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="vertical-align:middle"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                                            @doc.Ministro
                                        </span>
                                    }
                                    @if (doc.Musicas?.Count > 0)
                                    {
                                        <span>
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="vertical-align:middle"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="20" cy="16" r="3"/></svg>
                                            @doc.Musicas.Count música(s)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div style="display:flex;gap:6px;flex-shrink:0">
                                <button class="ws-btn ws-btn-ghost ws-btn-sm view-escala-btn"
                                        data-id="@doc.Id" title="Visualizar escala">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    Ver
                                </button>
                                <a href="@Url.Action("Edit","Escala", new { id = doc.Id })"
                                   class="ws-btn ws-btn-ghost ws-btn-sm" title="Editar">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                </a>
                                <button class="ws-btn ws-btn-danger ws-btn-sm delete-escala-btn"
                                        data-id="@doc.Id" title="Excluir">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                </div><!-- month-body -->
            </div>
        }
    }
</div>

<!-- Escala view modal -->
<style>
@@keyframes vm-shimmer {
    0%   { background-position: -400px 0; }
    100% { background-position:  400px 0; }
}
.vm-skel {
    background: linear-gradient(90deg, var(--border-card) 25%, #2e2820 50%, var(--border-card) 75%);
    background-size: 800px 100%;
    animation: vm-shimmer 1.4s infinite linear;
    border-radius: 6px;
}
.lyr-toggle-btn {
    display:flex;align-items:center;gap:6px;
    width:100%;padding:5px 2px;margin-top:2px;
    background:none;border:none;cursor:pointer;
    font-family:inherit;font-size:12px;color:var(--text-dim);
    transition:color .12s;
}
.lyr-toggle-btn:hover { color:var(--accent); }
.lyr-chevron { transition:transform .2s;flex-shrink:0; }
</style>

<div id="view-modal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.75);align-items:flex-start;justify-content:center;padding:20px;overflow-y:auto">
    <div style="background:var(--bg-card);border:1px solid var(--border-card);border-radius:16px;width:min(96vw,620px);margin:auto;display:flex;flex-direction:column;position:relative">

        <!-- Loading skeleton (shown while fetching) -->
        <div id="vm-loading" style="padding:22px;display:flex;flex-direction:column;gap:14px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
                <div style="display:flex;flex-direction:column;gap:8px;flex:1">
                    <div class="vm-skel" style="height:18px;width:55%"></div>
                    <div class="vm-skel" style="height:13px;width:38%"></div>
                </div>
                <div style="width:28px;height:28px;border-radius:50%;background:var(--border-card)"></div>
            </div>
            <div style="border-top:1px solid var(--border-card);padding-top:16px;display:flex;flex-direction:column;gap:12px">
                <div class="vm-skel" style="height:46px;border-radius:10px"></div>
                <div class="vm-skel" style="height:46px;border-radius:10px"></div>
                <div class="vm-skel" style="height:46px;border-radius:10px"></div>
            </div>
        </div>

        <!-- Actual content (hidden until loaded) -->
        <div id="vm-content" style="display:none;flex-direction:column">

            <!-- Header -->
            <div style="padding:20px 22px 16px;border-bottom:1px solid var(--border-card)">
                <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
                    <div id="vm-header" style="min-width:0;flex:1"></div>
                    <button onclick="closeViewModal()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:24px;line-height:1;flex-shrink:0;margin-top:-2px">×</button>
                </div>
            </div>

            <!-- Song list -->
            <div id="vm-songs" style="padding:0 22px;max-height:52vh;overflow-y:auto"></div>

            <!-- Message preview -->
            <div style="margin:4px 22px 16px;border-radius:12px;border:1px solid rgba(214,145,95,.25);background:linear-gradient(135deg,rgba(214,145,95,.05),rgba(0,0,0,.1));padding:14px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span style="font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--accent)">Mensagem para o grupo</span>
                </div>
                <pre id="vm-text" style="margin:0;white-space:pre-wrap;font-family:inherit;font-size:13px;line-height:1.75;color:var(--text-sub)"></pre>
            </div>

            <!-- Footer -->
            <div style="padding:12px 22px 20px;border-top:1px solid var(--border-card);display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                <button id="vm-copy-btn" onclick="doViewCopy()" class="ws-btn ws-btn-primary ws-btn-sm">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    Copiar mensagem
                </button>
                <button id="vm-share-btn" onclick="doShare()" class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    Compartilhar
                </button>
                <a id="vm-edit-link" href="#" class="ws-btn ws-btn-ghost ws-btn-sm">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Editar
                </a>
                <button onclick="closeViewModal()" class="ws-btn ws-btn-ghost ws-btn-sm" style="margin-left:auto">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Month toggles ─────────────────────────────────────────────────────────────

var STORAGE_KEY = 'escala-months-collapsed';

function getCollapsed() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch(e) { return []; }
}
function saveCollapsed(list) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch(e) {}
}

function toggleMonth(key, headerEl) {
    var body = document.querySelector('[data-month-body="' + key + '"]');
    var chevron = headerEl.querySelector('.month-chevron');
    var collapsed = getCollapsed();
    var isNowCollapsed = !body.classList.contains('collapsed');

    if (isNowCollapsed) {
        body.style.maxHeight = body.scrollHeight + 'px';
        requestAnimationFrame(function() {
            body.classList.add('collapsed');
            body.style.maxHeight = '';
        });
        chevron.style.transform = 'rotate(-90deg)';
        if (!collapsed.includes(key)) collapsed.push(key);
    } else {
        body.classList.remove('collapsed');
        body.style.maxHeight = body.scrollHeight + 'px';
        setTimeout(function() { body.style.maxHeight = ''; }, 250);
        chevron.style.transform = '';
        collapsed = collapsed.filter(function(k) { return k !== key; });
    }
    saveCollapsed(collapsed);
}

// Apply saved state on load
(function() {
    var collapsed = getCollapsed();
    document.querySelectorAll('[data-month-group]').forEach(function(group) {
        var key = group.dataset.monthGroup;
        var body = group.querySelector('[data-month-body]');
        var chevron = group.querySelector('.month-chevron');
        if (!body || !chevron) return;
        body.style.maxHeight = 'none';
        if (collapsed.includes(key)) {
            body.classList.add('collapsed');
            body.style.maxHeight = '';
            chevron.style.transform = 'rotate(-90deg)';
        }
    });
})();

// ── View modal ────────────────────────────────────────────────────────────────

var getUrl    = '@Url.Action("Get","Escala")';
var copyUrl   = '@Url.Action("CopyText","Escala")';
var lyricsUrl = '@Url.Action("Lyrics","Escala")';
var deleteUrl = '@Url.Action("Delete","Escala")';
var editBase  = '@Url.Action("Edit","Escala")';

var _currentEscalaId = '';

document.querySelectorAll('.view-escala-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        openViewModal(this.dataset.id);
    });
});

async function openViewModal(id) {
    _currentEscalaId = id;
    var modal = document.getElementById('view-modal');
    modal.style.display = 'flex';
    document.getElementById('vm-loading').style.display = 'flex';
    document.getElementById('vm-content').style.display = 'none';
    try {
        var [docRes, textRes] = await Promise.all([
            fetch(getUrl + '?id=' + encodeURIComponent(id)).then(r => r.json()),
            fetch(copyUrl + '?id=' + encodeURIComponent(id)).then(r => r.text())
        ]);
        renderViewModal(docRes, textRes);
        document.getElementById('vm-loading').style.display = 'none';
        document.getElementById('vm-content').style.display = 'flex';
    } catch(e) {
        document.getElementById('vm-loading').innerHTML = '<div style="padding:22px;color:#ff8a80;font-size:14px">Erro ao carregar escala.</div>';
    }
}

function renderViewModal(doc, copyText) {
    var days = ['Domingo','Segunda-feira','Terça-feira','Quarta-feira','Quinta-feira','Sexta-feira','Sábado'];
    var dateStr = '';
    if (doc.data) {
        var d = new Date(doc.data + 'T12:00:00');
        if (!isNaN(d)) dateStr = days[d.getDay()] + ', ' + String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + d.getFullYear();
    }

    document.getElementById('vm-header').innerHTML =
        '<div style="font-weight:600;font-size:17px;margin-bottom:4px">' + esc(doc.titulo || '(sem título)') + '</div>'
        + '<div style="display:flex;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--text-muted)">'
        + (dateStr ? '<span>📅 ' + esc(dateStr) + '</span>' : '')
        + (doc.ministro ? '<span>🎤 ' + esc(doc.ministro) + '</span>' : '')
        + ((doc.musicas||[]).length ? '<span>🎵 ' + doc.musicas.length + ' música(s)</span>' : '')
        + '</div>';

    document.getElementById('vm-edit-link').href = editBase + '?id=' + encodeURIComponent(doc.id);

    var musicas = doc.musicas || [];
    if (!musicas.length) {
        document.getElementById('vm-songs').innerHTML = '<div style="padding:18px 0;text-align:center;color:var(--text-dim);font-size:13.5px">Nenhuma música adicionada.</div>';
    } else {
        var curMom = null;
        var html = '<div style="padding:12px 0">';
        musicas.forEach(function(m, i) {
            var mom = (m.momento || '').trim();
            if (mom && mom !== curMom) {
                html += '<div style="font-size:11px;text-transform:uppercase;letter-spacing:.7px;color:var(--accent);font-weight:600;padding:' + (i===0?'4':'14') + 'px 0 6px">' + esc(mom) + '</div>';
                curMom = mom;
            }
            var yt = (m.youtube_url || '').trim();
            var vid = ytVideoId(yt);
            var hasFile = !!(m.file_name || '').trim();
            html += '<div id="vm-song-' + i + '" style="border-bottom:1px solid var(--border-card)">';
            // main row
            html += '<div style="display:flex;align-items:center;gap:12px;padding:9px 0">'
                + '<div style="width:22px;height:22px;border-radius:50%;background:var(--accent-soft);border:1px solid var(--accent-line);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:var(--accent);flex-shrink:0">' + (i+1) + '</div>'
                + '<div style="flex:1;min-width:0">'
                + '<div style="font-weight:500;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + esc(m.titulo||'') + '</div>'
                + '<div style="font-size:12px;color:var(--text-muted)">' + esc(m.artista||'') + (m.obs ? ' · <em>' + esc(m.obs) + '</em>' : '') + '</div>'
                + '</div>';
            if (vid) {
                html += '<button type="button" onclick="toggleEmbed(' + i + ',\'' + vid + '\')" id="vm-yt-btn-' + i + '"'
                    + ' style="flex-shrink:0;background:none;border:none;cursor:pointer;color:#ff4e4e;padding:2px" title="Assistir">'
                    + '<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon fill="white" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>'
                    + '</button>';
            } else {
                html += '<span style="flex-shrink:0;opacity:.25" title="Sem link YouTube"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><line x1="8" y1="12" x2="16" y2="12"/></svg></span>';
            }
            html += '</div>';
            // embed slot
            html += '<div id="vm-embed-' + i + '" style="display:none;padding-bottom:12px">'
                + '<div style="position:relative;padding-bottom:56.25%;border-radius:10px;overflow:hidden;background:#000">'
                + '<iframe id="vm-iframe-' + i + '" width="100%" height="100%" style="position:absolute;top:0;left:0;border:none" allowfullscreen allow="autoplay;encrypted-media"></iframe>'
                + '</div></div>';
            // lyrics toggle (only when song has a library file)
            if (hasFile) {
                html += '<button class="lyr-toggle-btn" id="vm-lyr-btn-' + i + '" onclick="toggleLyrics(' + i + ',\'' + esc(m.file_name) + '\')">'
                    + '<svg class="lyr-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>'
                    + 'Ver letra'
                    + '</button>'
                    + '<div id="vm-lyrics-' + i + '" style="display:none;padding-bottom:14px">'
                    + '<pre id="vm-lyrics-text-' + i + '" style="margin:0;white-space:pre-wrap;font-family:inherit;font-size:12.5px;line-height:1.8;color:var(--text-sub);max-height:260px;overflow-y:auto;border-radius:8px;background:rgba(0,0,0,.18);padding:12px 14px;border:1px solid var(--border-card)"></pre>'
                    + '<button onclick="copyLyrics(' + i + ')" style="margin-top:8px;background:none;border:1px solid var(--border-card);border-radius:6px;padding:4px 10px;font-size:11.5px;color:var(--text-dim);cursor:pointer;font-family:inherit" id="vm-lyr-copy-' + i + '">Copiar letra</button>'
                    + '</div>';
            }
            html += '</div>';
        });
        html += '</div>';
        document.getElementById('vm-songs').innerHTML = html;
    }

    document.getElementById('vm-text').textContent = copyText;
}

async function toggleLyrics(idx, fileName) {
    var btn    = document.getElementById('vm-lyr-btn-' + idx);
    var slot   = document.getElementById('vm-lyrics-' + idx);
    var pre    = document.getElementById('vm-lyrics-text-' + idx);
    var chevron = btn ? btn.querySelector('.lyr-chevron') : null;
    var isOpen = slot.style.display !== 'none';

    if (isOpen) {
        slot.style.display = 'none';
        if (chevron) chevron.style.transform = '';
        if (btn) btn.querySelector('span,text') ;
        return;
    }

    slot.style.display = 'block';
    if (chevron) chevron.style.transform = 'rotate(180deg)';

    if (!slot.dataset.loaded) {
        pre.textContent = 'Carregando…';
        try {
            var res = await fetch(lyricsUrl + '?fileName=' + encodeURIComponent(fileName));
            var data = await res.json();
            pre.textContent = data.lyrics || '(letra não disponível)';
            slot.dataset.loaded = '1';
        } catch(e) {
            pre.textContent = 'Erro ao carregar letra.';
        }
    }
}

function copyLyrics(idx) {
    var pre  = document.getElementById('vm-lyrics-text-' + idx);
    var btn  = document.getElementById('vm-lyr-copy-' + idx);
    var text = pre ? pre.textContent : '';
    var done = function() {
        var orig = btn.textContent;
        btn.textContent = 'Copiado!';
        setTimeout(function() { btn.textContent = orig; }, 2000);
    };
    if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(done);
    } else {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta); done();
    }
}

function ytVideoId(url) {
    if (!url) return '';
    var m = url.match(/youtu\.be\/([A-Za-z0-9_-]{6,15})/);
    if (m) return m[1];
    m = url.match(/[?&]v=([A-Za-z0-9_-]{6,15})/);
    if (m) return m[1];
    return '';
}

function toggleEmbed(idx, vid) {
    var slot   = document.getElementById('vm-embed-' + idx);
    var iframe = document.getElementById('vm-iframe-' + idx);
    var btn    = document.getElementById('vm-yt-btn-' + idx);
    var open   = slot.style.display === 'none';
    document.querySelectorAll('[id^="vm-embed-"]').forEach(function(el) {
        var i = el.id.replace('vm-embed-', '');
        el.style.display = 'none';
        var f = document.getElementById('vm-iframe-' + i);
        if (f) f.src = '';
    });
    document.querySelectorAll('[id^="vm-yt-btn-"]').forEach(function(b) {
        b.style.color = '#ff4e4e'; b.style.background = 'none';
    });
    if (open) {
        slot.style.display = 'block';
        iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1';
        if (btn) { btn.style.color = '#fff'; btn.style.background = '#ff4e4e'; btn.style.borderRadius = '6px'; }
    }
}

function closeViewModal() {
    document.querySelectorAll('[id^="vm-iframe-"]').forEach(function(f) { f.src = ''; });
    document.getElementById('view-modal').style.display = 'none';
    _currentEscalaId = '';
}

function doViewCopy() {
    var text = document.getElementById('vm-text').textContent;
    var btn  = document.getElementById('vm-copy-btn');
    var orig = btn.innerHTML;
    var done = function() {
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Copiado!';
        setTimeout(function() { btn.innerHTML = orig; }, 2000);
    };
    if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(done);
    } else {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta); done();
    }
}

function doShare() {
    var url = window.location.origin + '/Escala/Index?view=' + encodeURIComponent(_currentEscalaId);
    var btn  = document.getElementById('vm-share-btn');
    var orig = btn.innerHTML;
    var done = function() {
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg> Link copiado!';
        setTimeout(function() { btn.innerHTML = orig; }, 2500);
    };
    if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(done);
    } else {
        var ta = document.createElement('textarea');
        ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy');
        document.body.removeChild(ta); done();
    }
}

// ── Delete ────────────────────────────────────────────────────────────────────

document.querySelectorAll('.delete-escala-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        if (!confirm('Excluir esta escala?')) return;
        var id = this.dataset.id;
        var row = this.closest('.escala-card');
        fetch(deleteUrl + '?id=' + encodeURIComponent(id), { method: 'POST' })
            .then(function() { row.style.transition = 'opacity .25s'; row.style.opacity = '0'; setTimeout(function() { row.remove(); }, 260); })
            .catch(function() { alert('Erro ao excluir.'); });
    });
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeViewModal();
});

document.getElementById('view-modal').addEventListener('click', function(e) {
    if (e.target === this) closeViewModal();
});

function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Auto-open from ?view= query param ────────────────────────────────────────
(function() {
    var autoId = '@(ViewBag.AutoViewId ?? "")';
    if (autoId) openViewModal(autoId);
})();
</script>
}
